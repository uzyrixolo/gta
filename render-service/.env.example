# Auth for the /render endpoint. Any long random string; the theme never sees it.
RENDER_TOKEN=change-me

# Shopify webhook signing secret (Admin > Settings > Notifications > Webhooks)
SHOPIFY_WEBHOOK_SECRET=

# Shopify Admin API access token, used to write the print-file links back onto the
# order. Create a custom app with scopes: read_orders, write_orders.
SHOPIFY_SHOP=rfa089-71.myshopify.com
SHOPIFY_ADMIN_TOKEN=

# Where finished print files are stored (same Uploadcare project the customizer uses)
UPLOADCARE_PUBLIC_KEY=6e122e88e1f265b83a7f
UPLOADCARE_CDN_BASE=2nfggcljwz.ucarecd.net

# Output settings
PRINT_DPI=300
# Hard cap so one silly order cannot allocate gigabytes
MAX_PIXELS=40000000
