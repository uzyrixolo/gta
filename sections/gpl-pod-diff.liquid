{%- comment -%}
  GTA Print Lab — Print On Demand page: "Why GTA Print Lab POD is different"
  Six centred icon columns with title + short description.
{%- endcomment -%}

{%- assign s = section.settings -%}

<section id="gpl-pod-diff-{{ section.id }}" class="gpl-pod-diff">
  <div class="gpl-pod-diff__inner">
    {%- if s.heading != blank -%}
      <h2 class="gpl-pod-diff__heading">{{ s.heading }}</h2>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="gpl-pod-diff__grid">
        {%- for block in section.blocks -%}
          <div class="gpl-pod-diff-item" {{ block.shopify_attributes }}>
            {%- if block.settings.icon != blank -%}
              <span class="gpl-pod-diff-item__icon">{{ block.settings.icon }}</span>
            {%- endif -%}
            {%- if block.settings.title != blank -%}
              <p class="gpl-pod-diff-item__title">{{ block.settings.title }}</p>
            {%- endif -%}
            {%- if block.settings.description != blank -%}
              <p class="gpl-pod-diff-item__desc">{{ block.settings.description }}</p>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% style %}
  #gpl-pod-diff-{{ section.id }} {
    --gpl-accent: {{ s.color_accent | default: '#D71920' }};
    background: {{ s.color_background | default: '#0A0A0A' }};
    padding: clamp(26px, 3vw, 44px) 0;
  }
  #gpl-pod-diff-{{ section.id }} .gpl-pod-diff__inner {
    box-sizing: border-box;
    width: min(1520px, calc(100% - clamp(28px, 3.2vw, 48px)));
    margin: 0 auto;
  }
  #gpl-pod-diff-{{ section.id }} .gpl-pod-diff__heading {
    margin: 0 0 clamp(18px, 2vw, 30px);
    text-align: center;
    color: #FFFFFF;
    font-family: var(--gpl-font-heading, inherit);
    font-weight: 800;
    text-transform: uppercase;
    line-height: 1.05;
    letter-spacing: -0.005em;
    font-size: clamp(20px, 2.4vw, 34px);
  }
  #gpl-pod-diff-{{ section.id }} .gpl-pod-diff__grid {
    display: grid;
    grid-template-columns: repeat({{ section.blocks.size | at_least: 1 }}, minmax(0, 1fr));
  }
  #gpl-pod-diff-{{ section.id }} .gpl-pod-diff-item {
    min-width: 0;
    text-align: center;
    padding: clamp(4px, 0.5vw, 8px) clamp(10px, 1.2vw, 20px);
    border-left: 1px solid rgba(255, 255, 255, 0.14);
  }
  #gpl-pod-diff-{{ section.id }} .gpl-pod-diff-item:first-child { border-left: none; }
  #gpl-pod-diff-{{ section.id }} .gpl-pod-diff-item__icon {
    display: flex;
    justify-content: center;
    color: var(--gpl-accent);
    margin-bottom: 10px;
  }
  #gpl-pod-diff-{{ section.id }} .gpl-pod-diff-item__icon svg {
    width: clamp(32px, 2.8vw, 46px);
    height: clamp(32px, 2.8vw, 46px);
  }
  #gpl-pod-diff-{{ section.id }} .gpl-pod-diff-item__title {
    margin: 0 0 5px;
    color: #FFFFFF;
    font-weight: 800;
    text-transform: uppercase;
    font-size: clamp(10px, 0.74vw, 12.5px);
    line-height: 1.2;
  }
  #gpl-pod-diff-{{ section.id }} .gpl-pod-diff-item__desc {
    margin: 0;
    color: #9C9C9C;
    font-size: clamp(9.5px, 0.66vw, 11.5px);
    line-height: 1.4;
  }

  @media screen and (max-width: 1199px) {
    #gpl-pod-diff-{{ section.id }} .gpl-pod-diff__grid { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 20px 0; }
    #gpl-pod-diff-{{ section.id }} .gpl-pod-diff-item:nth-child(3n + 1) { border-left: none; }
    #gpl-pod-diff-{{ section.id }} .gpl-pod-diff-item__title { font-size: 12.5px; }
    #gpl-pod-diff-{{ section.id }} .gpl-pod-diff-item__desc { font-size: 11.5px; }
  }
  @media screen and (max-width: 749px) {
    #gpl-pod-diff-{{ section.id }} .gpl-pod-diff__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    #gpl-pod-diff-{{ section.id }} .gpl-pod-diff-item { border-left: none; }
    #gpl-pod-diff-{{ section.id }} .gpl-pod-diff-item:nth-child(2n) { border-left: 1px solid rgba(255, 255, 255, 0.14); }
  }
{% endstyle %}

{% schema %}
{
  "name": "POD Differentiators",
  "tag": "section",
  "class": "gpl-section-pod-diff",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Why GTA Print Lab POD Is Different" },
    { "type": "color", "id": "color_accent", "label": "Accent", "default": "#D71920" },
    { "type": "color", "id": "color_background", "label": "Background", "default": "#0A0A0A" }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Differentiator",
      "limit": 6,
      "settings": [
        { "type": "html", "id": "icon", "label": "Icon (SVG code)" },
        { "type": "text", "id": "title", "label": "Title", "default": "Boutique Service" },
        { "type": "textarea", "id": "description", "label": "Description", "default": "We treat every brand like our own. Real people. Real support. Real results." }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [{ "name": "POD Differentiators" }]
}
{% endschema %}
