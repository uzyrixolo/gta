{%- comment -%}
  GTA Print Lab — Fast Track Headwear page: Hero
  Mirrors sections/gpl-gd-hero.liquid conventions (same accent/background tokens,
  same heading typography as the homepage hero).
{%- endcomment -%}

{%- assign s = section.settings -%}
{%- assign section_id = section.id -%}
{%- assign scrim = s.scrim_strength | divided_by: 100.0 -%}

<section id="gpl-ft-hero-{{ section_id }}" class="gpl-ft-hero">
  <div class="gpl-ft-hero__bg">
    {%- if s.background_image != blank -%}
      {{
        s.background_image
        | image_url: width: 2600
        | image_tag:
          class: 'gpl-ft-hero__bg-img gpl-ft-hero__bg-img--desktop',
          loading: 'eager',
          fetchpriority: 'high',
          sizes: '100vw',
          widths: '900, 1300, 1700, 2100, 2600',
          alt: s.background_image.alt | escape
      }}
    {%- endif -%}
    {%- if s.background_image_mobile != blank -%}
      {{
        s.background_image_mobile
        | image_url: width: 1200
        | image_tag:
          class: 'gpl-ft-hero__bg-img gpl-ft-hero__bg-img--mobile',
          loading: 'eager',
          fetchpriority: 'high',
          sizes: '100vw',
          widths: '500, 750, 1000, 1200',
          alt: s.background_image_mobile.alt | escape
      }}
    {%- endif -%}
  </div>
  <div class="gpl-ft-hero__scrim" aria-hidden="true"></div>

  {%- if s.badge_text != blank -%}
    <div class="gpl-ft-hero__badge">
      <span class="gpl-ft-hero__badge-bolt">
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M13 2 3 14h7l-1 8 11-14h-7z"/></svg>
      </span>
      <span class="gpl-ft-hero__badge-text">{{ s.badge_text }}</span>
    </div>
  {%- endif -%}

  <div class="gpl-ft-hero__inner">
    <div class="gpl-ft-hero__content">
      {%- if s.eyebrow != blank -%}
        <p class="gpl-ft-hero__eyebrow">{{ s.eyebrow }}</p>
      {%- endif -%}

      <h1 class="gpl-ft-hero__heading">
        {%- if s.heading_line1 != blank -%}
          <span class="gpl-ft-hero__heading-line">{{ s.heading_line1 }}</span>
        {%- endif -%}
        {%- if s.heading_line2 != blank -%}
          <span class="gpl-ft-hero__heading-line">{{ s.heading_line2 }}</span>
        {%- endif -%}
        {%- if s.heading_line3_prefix != blank or s.heading_line3_accent != blank -%}
          <span class="gpl-ft-hero__heading-line">{{ s.heading_line3_prefix }} <span class="gpl-ft-hero__heading-line--accent">{{ s.heading_line3_accent }}</span></span>
        {%- endif -%}
      </h1>

      {%- if s.subheading != blank -%}
        <p class="gpl-ft-hero__subheading">{{ s.subheading }}</p>
      {%- endif -%}

      {%- if s.paragraph != blank -%}
        <div class="gpl-ft-hero__paragraph">{{ s.paragraph }}</div>
      {%- endif -%}

      {%- if section.blocks.size > 0 -%}
        <div class="gpl-ft-hero__tiers">
          {%- for block in section.blocks -%}
            <div class="gpl-ft-hero-tier" {{ block.shopify_attributes }}>
              {%- if block.settings.icon != blank -%}
                <span class="gpl-ft-hero-tier__icon">{{ block.settings.icon }}</span>
              {%- endif -%}
              <span class="gpl-ft-hero-tier__copy">
                {%- if block.settings.title != blank -%}
                  <span class="gpl-ft-hero-tier__title">{{ block.settings.title }}</span>
                {%- endif -%}
                {%- if block.settings.subtitle != blank -%}
                  <span class="gpl-ft-hero-tier__sub">{{ block.settings.subtitle }}</span>
                {%- endif -%}
              </span>
            </div>
          {%- endfor -%}
        </div>
      {%- endif -%}

      {%- if s.button_1_text != blank or s.button_2_text != blank -%}
        <div class="gpl-ft-hero__buttons">
          {%- if s.button_1_text != blank -%}
            <a href="{{ s.button_1_link | default: '#' }}" class="gpl-ft-btn gpl-ft-btn--primary">
              <span>{{ s.button_1_text }}</span>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M5 12h14M13 5l7 7-7 7"/>
              </svg>
            </a>
          {%- endif -%}
          {%- if s.button_2_text != blank -%}
            <a href="{{ s.button_2_link | default: '#' }}" class="gpl-ft-btn gpl-ft-btn--outline">
              <span>{{ s.button_2_text }}</span>
            </a>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% style %}
  #gpl-ft-hero-{{ section_id }} {
    --gpl-accent: {{ s.color_accent | default: '#D71920' }};
    --gpl-bg: {{ s.color_background | default: '#0A0A0A' }};
    position: relative;
    display: flex;
    align-items: center;
    overflow: hidden;
    background: var(--gpl-bg);
    min-height: {{ s.min_height }}px;
  }
  #gpl-ft-hero-{{ section_id }} .gpl-ft-hero__bg { position: absolute; inset: 0; z-index: 0; }
  #gpl-ft-hero-{{ section_id }} .gpl-ft-hero__bg-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: {{ s.image_position }};
  }
  #gpl-ft-hero-{{ section_id }} .gpl-ft-hero__bg-img--mobile { display: none; }
  #gpl-ft-hero-{{ section_id }} .gpl-ft-hero__scrim {
    position: absolute;
    inset: 0;
    z-index: 1;
    background:
      linear-gradient(90deg, rgba(8,8,8,{{ scrim }}) 0%, rgba(8,8,8,{{ scrim }}) 40%, rgba(8,8,8,0.55) 62%, rgba(8,8,8,0.2) 100%),
      linear-gradient(0deg, rgba(8,8,8,0.65) 0%, rgba(8,8,8,0) 45%);
  }

  #gpl-ft-hero-{{ section_id }} .gpl-ft-hero__badge {
    position: absolute;
    z-index: 3;
    top: clamp(20px, 3vw, 40px);
    right: clamp(20px, 4vw, 64px);
    display: flex;
    align-items: center;
    gap: 8px;
    background: var(--gpl-accent);
    color: #FFFFFF;
    padding: 10px 16px;
    border-radius: 999px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    font-size: clamp(11px, 0.85vw, 13px);
    box-shadow: 0 8px 24px rgba(215, 25, 32, 0.35);
  }
  #gpl-ft-hero-{{ section_id }} .gpl-ft-hero__badge-bolt { display: flex; }
  #gpl-ft-hero-{{ section_id }} .gpl-ft-hero__badge-bolt svg { width: 15px; height: 15px; }

  #gpl-ft-hero-{{ section_id }} .gpl-ft-hero__inner {
    position: relative;
    z-index: 2;
    box-sizing: border-box;
    width: min(1520px, calc(100% - clamp(28px, 3.2vw, 48px)));
    margin: 0 auto;
    padding: clamp(48px, 6vw, 96px) 0;
  }
  #gpl-ft-hero-{{ section_id }} .gpl-ft-hero__content { max-width: 640px; }

  #gpl-ft-hero-{{ section_id }} .gpl-ft-hero__eyebrow {
    color: var(--gpl-accent);
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-size: 13px;
    margin: 0 0 8px;
  }
  #gpl-ft-hero-{{ section_id }} .gpl-ft-hero__heading {
    display: flex;
    flex-direction: column;
    font-family: var(--gpl-font-heading, inherit);
    font-weight: 800;
    line-height: 0.98;
    letter-spacing: -0.01em;
    text-transform: uppercase;
    font-size: clamp(34px, 5.4vw, 66px);
    color: #FFFFFF;
    margin: 0 0 16px;
  }
  #gpl-ft-hero-{{ section_id }} .gpl-ft-hero__heading-line--accent { color: var(--gpl-accent); }

  #gpl-ft-hero-{{ section_id }} .gpl-ft-hero__subheading {
    color: #FFFFFF;
    font-weight: 700;
    font-size: clamp(15px, 1.5vw, 21px);
    line-height: 1.3;
    margin: 0 0 12px;
    max-width: 34ch;
  }
  #gpl-ft-hero-{{ section_id }} .gpl-ft-hero__paragraph {
    color: #C9C9C9;
    font-size: clamp(13px, 1vw, 15px);
    line-height: 1.65;
    margin: 0 0 22px;
    max-width: 48ch;
  }
  #gpl-ft-hero-{{ section_id }} .gpl-ft-hero__paragraph p { margin: 0; }

  #gpl-ft-hero-{{ section_id }} .gpl-ft-hero__tiers {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(10px, 1.2vw, 18px);
    margin: 0 0 26px;
    padding: clamp(14px, 1.4vw, 20px) 0;
    border-top: 1px solid rgba(255, 255, 255, 0.16);
    border-bottom: 1px solid rgba(255, 255, 255, 0.16);
  }
  #gpl-ft-hero-{{ section_id }} .gpl-ft-hero-tier {
    display: flex;
    align-items: flex-start;
    gap: 9px;
    min-width: 0;
  }
  #gpl-ft-hero-{{ section_id }} .gpl-ft-hero-tier__icon { flex: 0 0 auto; display: flex; color: var(--gpl-accent); }
  #gpl-ft-hero-{{ section_id }} .gpl-ft-hero-tier__icon svg { width: clamp(20px, 1.7vw, 26px); height: clamp(20px, 1.7vw, 26px); }
  #gpl-ft-hero-{{ section_id }} .gpl-ft-hero-tier__copy { min-width: 0; display: flex; flex-direction: column; gap: 2px; }
  #gpl-ft-hero-{{ section_id }} .gpl-ft-hero-tier__title {
    color: #FFFFFF;
    font-weight: 800;
    text-transform: uppercase;
    font-size: clamp(11px, 0.85vw, 13px);
    line-height: 1.2;
  }
  #gpl-ft-hero-{{ section_id }} .gpl-ft-hero-tier__sub {
    color: #A8A8A8;
    font-size: clamp(10px, 0.7vw, 11.5px);
    line-height: 1.3;
  }

  #gpl-ft-hero-{{ section_id }} .gpl-ft-hero__buttons { display: flex; flex-wrap: wrap; gap: 12px; }
  #gpl-ft-hero-{{ section_id }} .gpl-ft-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 9px;
    padding: 14px 26px;
    border-radius: 5px;
    border: 2px solid transparent;
    font-weight: 800;
    font-size: clamp(12px, 0.95vw, 14px);
    letter-spacing: 0.03em;
    text-transform: uppercase;
    text-decoration: none;
    transition: background-color 0.2s ease, border-color 0.2s ease, transform 0.15s ease;
  }
  #gpl-ft-hero-{{ section_id }} .gpl-ft-btn svg { width: 16px; height: 16px; }
  #gpl-ft-hero-{{ section_id }} .gpl-ft-btn--primary { background: var(--gpl-accent); color: #FFFFFF; }
  #gpl-ft-hero-{{ section_id }} .gpl-ft-btn--primary:hover { background: #B5141A; transform: translateY(-1px); }
  #gpl-ft-hero-{{ section_id }} .gpl-ft-btn--outline {
    background: rgba(20, 20, 20, 0.72);
    color: #FFFFFF;
    border-color: rgba(255, 255, 255, 0.35);
  }
  #gpl-ft-hero-{{ section_id }} .gpl-ft-btn--outline:hover { border-color: #FFFFFF; background: rgba(255, 255, 255, 0.1); }
  #gpl-ft-hero-{{ section_id }} .gpl-ft-btn:focus-visible { outline: 3px solid #FFFFFF; outline-offset: 3px; }

  @media screen and (max-width: 989px) {
    #gpl-ft-hero-{{ section_id }} .gpl-ft-hero__content { max-width: 100%; }
    #gpl-ft-hero-{{ section_id }} .gpl-ft-hero__scrim {
      background:
        linear-gradient(90deg, rgba(8,8,8,{{ scrim }}) 0%, rgba(8,8,8,0.72) 70%, rgba(8,8,8,0.55) 100%),
        linear-gradient(0deg, rgba(8,8,8,0.7) 0%, rgba(8,8,8,0) 50%);
    }
  }
  @media screen and (max-width: 749px) {
    #gpl-ft-hero-{{ section_id }} { min-height: {{ s.min_height_mobile }}px; }
    {%- if s.background_image_mobile != blank -%}
      #gpl-ft-hero-{{ section_id }} .gpl-ft-hero__bg-img--desktop { display: none; }
      #gpl-ft-hero-{{ section_id }} .gpl-ft-hero__bg-img--mobile { display: block; }
    {%- endif -%}
    #gpl-ft-hero-{{ section_id }} .gpl-ft-hero__subheading,
    #gpl-ft-hero-{{ section_id }} .gpl-ft-hero__paragraph { max-width: 100%; }
    #gpl-ft-hero-{{ section_id }} .gpl-ft-hero__tiers { grid-template-columns: minmax(0, 1fr); gap: 12px; }
    #gpl-ft-hero-{{ section_id }} .gpl-ft-btn { flex: 1 1 100%; }
    #gpl-ft-hero-{{ section_id }} .gpl-ft-hero__badge { position: static; display: inline-flex; margin-bottom: 16px; }
  }

  @media (prefers-reduced-motion: reduce) {
    #gpl-ft-hero-{{ section_id }} .gpl-ft-btn { transition: none; }
    #gpl-ft-hero-{{ section_id }} .gpl-ft-btn--primary:hover { transform: none; }
  }
{% endstyle %}

{% schema %}
{
  "name": "FT Hero",
  "tag": "section",
  "class": "gpl-section-ft-hero",
  "settings": [
    { "type": "header", "content": "Background" },
    { "type": "image_picker", "id": "background_image", "label": "Background image" },
    { "type": "image_picker", "id": "background_image_mobile", "label": "Background image (mobile)", "info": "Optional. Falls back to the desktop image." },
    { "type": "select", "id": "image_position", "label": "Image focal point", "default": "center right", "options": [
      { "value": "center left", "label": "Left" },
      { "value": "center center", "label": "Centre" },
      { "value": "center right", "label": "Right" }
    ] },
    { "type": "range", "id": "scrim_strength", "label": "Dark overlay on text side", "min": 30, "max": 100, "step": 5, "unit": "%", "default": 90 },
    { "type": "range", "id": "min_height", "label": "Minimum height", "min": 320, "max": 900, "step": 10, "unit": "px", "default": 620 },
    { "type": "range", "id": "min_height_mobile", "label": "Minimum height (mobile)", "min": 280, "max": 900, "step": 10, "unit": "px", "default": 620 },

    { "type": "header", "content": "Badge" },
    { "type": "text", "id": "badge_text", "label": "Corner badge text", "default": "FAST TRACK" },

    { "type": "header", "content": "Content" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "GTA FAST TRACK™ HEADWEAR" },
    { "type": "text", "id": "heading_line1", "label": "Heading line 1", "default": "Your Brand." },
    { "type": "text", "id": "heading_line2", "label": "Heading line 2", "default": "Your Deadline." },
    { "type": "text", "id": "heading_line3_prefix", "label": "Heading line 3 — prefix (white)", "default": "Our" },
    { "type": "text", "id": "heading_line3_accent", "label": "Heading line 3 — accent (red)", "default": "Fast Track." },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "In-stock. Verified. Ready to decorate." },
    { "type": "richtext", "id": "paragraph", "label": "Paragraph", "default": "<p>Premium headwear with seriously fast turnarounds. Skip the wait and get branded hats moving — for launches, events, teams and last-minute promotions.</p>" },

    { "type": "header", "content": "Buttons" },
    { "type": "text", "id": "button_1_text", "label": "Button 1 text", "default": "Shop Fast Track Headwear" },
    { "type": "url", "id": "button_1_link", "label": "Button 1 link" },
    { "type": "text", "id": "button_2_text", "label": "Button 2 text", "default": "Get a Quote" },
    { "type": "url", "id": "button_2_link", "label": "Button 2 link" },

    { "type": "header", "content": "Colours" },
    { "type": "color", "id": "color_accent", "label": "Accent", "default": "#D71920" },
    { "type": "color", "id": "color_background", "label": "Background", "default": "#0A0A0A" }
  ],
  "blocks": [
    {
      "type": "tier",
      "name": "Production tier",
      "limit": 3,
      "settings": [
        { "type": "html", "id": "icon", "label": "Icon (SVG code)" },
        { "type": "text", "id": "title", "label": "Title", "default": "Print Today" },
        { "type": "text", "id": "subtitle", "label": "Subtitle", "default": "Order by cutoff. We print today." }
      ]
    }
  ],
  "max_blocks": 3,
  "presets": [{ "name": "FT Hero" }]
}
{% endschema %}
