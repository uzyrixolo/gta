{%- comment -%}
  GTA Print Lab — Branding page: Pricing packages
  Up to 4 package columns, each with icon, name, tagline, price, feature list and button.
{%- endcomment -%}

{%- assign s = section.settings -%}

<section id="gpl-brand-pkg-{{ section.id }}" class="gpl-brand-pkg">
  <div class="gpl-brand-pkg__inner">
    {%- if s.heading != blank -%}
      <h2 class="gpl-brand-pkg__heading">{{ s.heading }}</h2>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="gpl-brand-pkg__grid">
        {%- for block in section.blocks -%}
          <article class="gpl-brand-pkg-card" {{ block.shopify_attributes }}>
            <div class="gpl-brand-pkg-card__head">
              {%- if block.settings.icon != blank -%}
                <span class="gpl-brand-pkg-card__icon">{{ block.settings.icon }}</span>
              {%- endif -%}
              {%- if block.settings.name != blank -%}
                <h3 class="gpl-brand-pkg-card__name">{{ block.settings.name }}</h3>
              {%- endif -%}
              {%- if block.settings.tagline != blank -%}
                <p class="gpl-brand-pkg-card__tagline">{{ block.settings.tagline }}</p>
              {%- endif -%}
              {%- if block.settings.price != blank -%}
                <p class="gpl-brand-pkg-card__price">{{ block.settings.price }}</p>
              {%- endif -%}
              {%- if block.settings.price_note != blank -%}
                <p class="gpl-brand-pkg-card__price-note">{{ block.settings.price_note }}</p>
              {%- endif -%}
            </div>

            {%- assign features = block.settings.features | newline_to_br | split: '<br />' -%}
            {%- if block.settings.features != blank -%}
              <ul class="gpl-brand-pkg-card__list">
                {%- for feature in features -%}
                  {%- assign f = feature | strip -%}
                  {%- if f != blank -%}
                    <li>
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M4 12.5l5 5L20 6.5"/>
                      </svg>
                      <span>{{ f }}</span>
                    </li>
                  {%- endif -%}
                {%- endfor -%}
              </ul>
            {%- endif -%}

            {%- if block.settings.button_text != blank -%}
              <a href="{{ block.settings.button_link | default: '#' }}" class="gpl-brand-pkg-card__btn">
                {{ block.settings.button_text }}
              </a>
            {%- endif -%}
          </article>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if s.footnote != blank -%}
      <p class="gpl-brand-pkg__footnote">{{ s.footnote }}</p>
    {%- endif -%}
  </div>
</section>

{% style %}
  #gpl-brand-pkg-{{ section.id }} {
    --gpl-accent: {{ s.color_accent | default: '#D71920' }};
    background: {{ s.color_background | default: '#0A0A0A' }};
    padding: 0 0 clamp(28px, 3.2vw, 46px);
  }
  #gpl-brand-pkg-{{ section.id }} .gpl-brand-pkg__inner {
    box-sizing: border-box;
    width: min(1520px, calc(100% - clamp(28px, 3.2vw, 48px)));
    margin: 0 auto;
  }
  #gpl-brand-pkg-{{ section.id }} .gpl-brand-pkg__heading {
    margin: 0 0 clamp(16px, 1.8vw, 26px);
    text-align: center;
    color: #FFFFFF;
    font-family: var(--gpl-font-heading, inherit);
    font-weight: 800;
    text-transform: uppercase;
    line-height: 1.05;
    letter-spacing: -0.005em;
    font-size: clamp(20px, 2.4vw, 34px);
  }
  #gpl-brand-pkg-{{ section.id }} .gpl-brand-pkg__grid {
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 8px;
    background: #101010;
    display: grid;
    grid-template-columns: repeat({{ section.blocks.size | at_least: 1 }}, minmax(0, 1fr));
    padding: clamp(14px, 1.6vw, 24px) 0;
  }
  #gpl-brand-pkg-{{ section.id }} .gpl-brand-pkg-card {
    display: flex;
    flex-direction: column;
    min-width: 0;
    padding: clamp(6px, 0.7vw, 10px) clamp(14px, 1.5vw, 24px);
    border-left: 1px solid rgba(255, 255, 255, 0.14);
  }
  #gpl-brand-pkg-{{ section.id }} .gpl-brand-pkg-card:first-child { border-left: none; }
  #gpl-brand-pkg-{{ section.id }} .gpl-brand-pkg-card__head { text-align: center; margin-bottom: clamp(10px, 1.1vw, 16px); }
  #gpl-brand-pkg-{{ section.id }} .gpl-brand-pkg-card__icon {
    display: flex;
    justify-content: center;
    color: var(--gpl-accent);
    margin-bottom: 8px;
  }
  #gpl-brand-pkg-{{ section.id }} .gpl-brand-pkg-card__icon svg {
    width: clamp(34px, 3vw, 50px);
    height: clamp(34px, 3vw, 50px);
  }
  #gpl-brand-pkg-{{ section.id }} .gpl-brand-pkg-card__name {
    margin: 0 0 3px;
    color: #FFFFFF;
    font-family: var(--gpl-font-heading, inherit);
    font-weight: 800;
    text-transform: uppercase;
    line-height: 1.1;
    font-size: clamp(14px, 1.15vw, 19px);
  }
  #gpl-brand-pkg-{{ section.id }} .gpl-brand-pkg-card__tagline {
    margin: 0 0 clamp(8px, 0.9vw, 13px);
    color: #9C9C9C;
    font-size: clamp(9.5px, 0.7vw, 12px);
    line-height: 1.35;
  }
  #gpl-brand-pkg-{{ section.id }} .gpl-brand-pkg-card__price {
    margin: 0;
    color: var(--gpl-accent);
    font-family: var(--gpl-font-heading, inherit);
    font-weight: 800;
    line-height: 1;
    font-size: clamp(24px, 2.3vw, 40px);
  }
  #gpl-brand-pkg-{{ section.id }} .gpl-brand-pkg-card__price-note {
    margin: 3px 0 0;
    color: #9C9C9C;
    text-transform: uppercase;
    font-weight: 700;
    letter-spacing: 0.05em;
    font-size: clamp(8.5px, 0.62vw, 10.5px);
  }
  #gpl-brand-pkg-{{ section.id }} .gpl-brand-pkg-card__list {
    list-style: none;
    margin: 0 0 clamp(12px, 1.4vw, 20px);
    padding: clamp(10px, 1.1vw, 16px) 0 0;
    border-top: 1px solid rgba(255, 255, 255, 0.12);
    display: flex;
    flex-direction: column;
    gap: clamp(6px, 0.6vw, 9px);
    flex: 1 1 auto;
  }
  #gpl-brand-pkg-{{ section.id }} .gpl-brand-pkg-card__list li {
    display: flex;
    align-items: flex-start;
    gap: 7px;
    color: #E4E4E4;
    font-size: clamp(10px, 0.72vw, 12.5px);
    line-height: 1.4;
  }
  #gpl-brand-pkg-{{ section.id }} .gpl-brand-pkg-card__list svg {
    flex: 0 0 auto;
    width: clamp(12px, 0.85vw, 14px);
    height: clamp(12px, 0.85vw, 14px);
    margin-top: 2px;
    color: var(--gpl-accent);
  }
  #gpl-brand-pkg-{{ section.id }} .gpl-brand-pkg-card__btn {
    display: block;
    text-align: center;
    padding: 11px 14px;
    border: 1.5px solid rgba(255, 255, 255, 0.55);
    border-radius: 4px;
    color: #FFFFFF;
    text-decoration: none;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    font-size: clamp(10px, 0.74vw, 12px);
    transition: background-color 0.2s ease, border-color 0.2s ease;
  }
  #gpl-brand-pkg-{{ section.id }} .gpl-brand-pkg-card__btn:hover {
    background: var(--gpl-accent);
    border-color: var(--gpl-accent);
  }
  #gpl-brand-pkg-{{ section.id }} .gpl-brand-pkg-card__btn:focus-visible { outline: 3px solid #FFFFFF; outline-offset: 3px; }
  #gpl-brand-pkg-{{ section.id }} .gpl-brand-pkg__footnote {
    margin: clamp(10px, 1.1vw, 16px) 0 0;
    text-align: center;
    color: #8A8A8A;
    font-size: clamp(10px, 0.72vw, 12.5px);
  }

  @media screen and (max-width: 1199px) {
    #gpl-brand-pkg-{{ section.id }} .gpl-brand-pkg__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 22px 0; }
    #gpl-brand-pkg-{{ section.id }} .gpl-brand-pkg-card:nth-child(2n + 1) { border-left: none; }
    #gpl-brand-pkg-{{ section.id }} .gpl-brand-pkg-card__list li { font-size: 12.5px; }
  }
  @media screen and (max-width: 649px) {
    #gpl-brand-pkg-{{ section.id }} .gpl-brand-pkg__grid { grid-template-columns: minmax(0, 1fr); gap: 20px; }
    #gpl-brand-pkg-{{ section.id }} .gpl-brand-pkg-card { border-left: none !important; }
  }
  @media (prefers-reduced-motion: reduce) {
    #gpl-brand-pkg-{{ section.id }} .gpl-brand-pkg-card__btn { transition: none; }
  }
{% endstyle %}

{% schema %}
{
  "name": "Brand Packages",
  "tag": "section",
  "class": "gpl-section-brand-pkg",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Branding Packages That Fit Your Vision" },
    { "type": "text", "id": "footnote", "label": "Footnote", "default": "All packages include revisions, support, and files you own 100%." },
    { "type": "color", "id": "color_accent", "label": "Accent", "default": "#D71920" },
    { "type": "color", "id": "color_background", "label": "Background", "default": "#0A0A0A" }
  ],
  "blocks": [
    {
      "type": "package",
      "name": "Package",
      "limit": 4,
      "settings": [
        { "type": "html", "id": "icon", "label": "Icon (SVG code)" },
        { "type": "text", "id": "name", "label": "Name", "default": "Starter Brand" },
        { "type": "text", "id": "tagline", "label": "Tagline", "default": "Perfect for new brands" },
        { "type": "text", "id": "price", "label": "Price", "default": "$999" },
        { "type": "text", "id": "price_note", "label": "Price note", "default": "One-Time" },
        { "type": "textarea", "id": "features", "label": "Feature list", "info": "One item per line.", "default": "Logo Design\nBrand Colors & Typography\nBrand Guidelines\nBusiness Card Design" },
        { "type": "text", "id": "button_text", "label": "Button text", "default": "Get Started" },
        { "type": "url", "id": "button_link", "label": "Button link" }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [{ "name": "Brand Packages" }]
}
{% endschema %}
