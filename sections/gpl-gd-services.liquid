{%- comment -%}
  GTA Print Lab — Graphic Design page: Services grid (M2)
  Six horizontal cards — image left, copy + turnaround chip right — built
  from the client's "Our Graphic Design Services" band: the title's closing
  words go red, the photos ship in assets/ (gd-svc-1..6.jpg, sliced from
  that band) and any image picked in the editor wins over them.
{%- endcomment -%}

{%- assign s = section.settings -%}

<section id="gpl-gd-svc-{{ section.id }}" class="gpl-gd-svc">
  <div class="gpl-gd-svc__inner">
    {%- if s.heading != blank or s.heading_accent != blank -%}
      <div class="gpl-gd-svc__heading">
        {% render 'gpl-section-heading', light: s.heading, accent: s.heading_accent, trail: s.heading_trail, tone: 'dark' %}
      </div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="gpl-gd-svc__grid">
        {%- for block in section.blocks -%}
          <article class="gpl-gd-svc-card" {{ block.shopify_attributes }}>
            <div class="gpl-gd-svc-card__media">
              {%- if block.settings.image != blank or block.settings.image_asset != blank -%}
                {%- assign card_alt = block.settings.image.alt | default: block.settings.title -%}
                {% render 'gpl-picture', img: block.settings.image, asset: block.settings.image_asset, alt: card_alt,
                   sizes: '(max-width: 749px) 45vw, (max-width: 1199px) 22vw, 15vw' %}
              {%- else -%}
                {{ 'image' | placeholder_svg_tag: 'gpl-gd-svc-card__ph' }}
              {%- endif -%}
            </div>

            <div class="gpl-gd-svc-card__body">
              {%- if block.settings.title != blank or block.settings.title_accent != blank -%}
                <h3 class="gpl-gd-svc-card__title">
                  {%- if block.settings.title != blank -%}<span>{{ block.settings.title }}</span>{%- endif -%}
                  {% if block.settings.title_accent != blank %} <span class="gpl-gd-svc-card__title-accent">{{ block.settings.title_accent }}</span>{% endif %}
                </h3>
              {%- endif -%}
              {%- if block.settings.description != blank -%}
                <p class="gpl-gd-svc-card__desc">{{ block.settings.description }}</p>
              {%- endif -%}
              {%- if block.settings.turnaround != blank -%}
                <p class="gpl-gd-svc-card__turn">
                  <span class="gpl-gd-svc-card__turn-icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>
                    </svg>
                  </span>
                  <span>{{ block.settings.turnaround }}</span>
                </p>
              {%- endif -%}
            </div>
          </article>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if s.button_text != blank -%}
      <div class="gpl-gd-svc__cta">
        <a href="{{ s.button_link | default: '#' }}" class="gpl-gd-svc__btn">
          <span>{{ s.button_text }}</span>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M5 12h14M13 5l7 7-7 7"/>
          </svg>
        </a>
      </div>
    {%- endif -%}
  </div>
</section>

{% style %}
  #gpl-gd-svc-{{ section.id }} {
    --gpl-accent: {{ s.color_accent | default: '#D71920' }};
    background: {{ s.color_background | default: '#0A0A0A' }};
    padding: clamp(34px, 4vw, 58px) 0;
  }
  #gpl-gd-svc-{{ section.id }} .gpl-gd-svc__inner {
    box-sizing: border-box;
    width: min(1520px, calc(100% - clamp(28px, 3.2vw, 48px)));
    margin: 0 auto;
  }
  #gpl-gd-svc-{{ section.id }} .gpl-gd-svc__heading { margin: 0 0 clamp(22px, 2.6vw, 40px); }

  #gpl-gd-svc-{{ section.id }} .gpl-gd-svc__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(12px, 1.2vw, 18px);
  }
  #gpl-gd-svc-{{ section.id }} .gpl-gd-svc-card {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
    background: #0D0D0D;
    border: 1.5px solid color-mix(in srgb, var(--gpl-accent) 70%, transparent);
    border-radius: 14px;
    overflow: hidden;
    min-width: 0;
  }
  #gpl-gd-svc-{{ section.id }} .gpl-gd-svc-card__media {
    position: relative;
    min-height: 100%;
    /* the band's photos are near-square; let them set the card height */
    aspect-ratio: 0.96 / 1;
    background: #1E1E1E;
  }
  #gpl-gd-svc-{{ section.id }} .gpl-gd-svc-card__media img,
  #gpl-gd-svc-{{ section.id }} .gpl-gd-svc-card__media svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  #gpl-gd-svc-{{ section.id }} .gpl-gd-svc-card__ph { background: #262626; fill: rgba(255,255,255,0.25); }

  #gpl-gd-svc-{{ section.id }} .gpl-gd-svc-card__body {
    display: flex;
    flex-direction: column;
    padding: clamp(16px, 1.6vw, 26px);
    justify-content: center;
    min-width: 0;
  }
  #gpl-gd-svc-{{ section.id }} .gpl-gd-svc-card__title {
    margin: 0 0 clamp(7px, 0.7vw, 10px);
    color: #FFFFFF;
    font-family: var(--gpl-font-heading, inherit);
    font-weight: 800;
    text-transform: uppercase;
    line-height: 1.02;
    letter-spacing: 0;
    font-size: clamp(20px, 2vw, 32px);
    display: flex; flex-direction: column;
  }
  #gpl-gd-svc-{{ section.id }} .gpl-gd-svc-card__desc {
    margin: 0 0 clamp(12px, 1.2vw, 18px);
    color: #E6E6E6;
    font-size: clamp(13px, 1.05vw, 16.5px);
    line-height: 1.45;
  }
  #gpl-gd-svc-{{ section.id }} .gpl-gd-svc-card__turn {
    margin: auto 0 0;
    display: flex;
    align-items: center;
    gap: 10px;
    color: #FFFFFF;
    font-weight: 800;
    text-transform: uppercase;
    font-size: clamp(12px, 1.05vw, 16px);
    letter-spacing: 0.01em;
  }
  #gpl-gd-svc-{{ section.id }} .gpl-gd-svc-card__title-accent { color: var(--gpl-accent); }
  #gpl-gd-svc-{{ section.id }} .gpl-gd-svc-card__turn-icon { display: flex; color: var(--gpl-accent); }
  #gpl-gd-svc-{{ section.id }} .gpl-gd-svc-card__turn-icon svg {
    width: clamp(22px, 1.9vw, 30px);
    height: clamp(22px, 1.9vw, 30px);
    stroke-width: 1.7;
  }

  #gpl-gd-svc-{{ section.id }} .gpl-gd-svc__cta { margin-top: clamp(18px, 2vw, 28px); text-align: center; }
  #gpl-gd-svc-{{ section.id }} .gpl-gd-svc__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 13px 28px;
    border: 2px solid var(--gpl-accent);
    border-radius: 5px;
    background: transparent;
    color: #FFFFFF;
    text-decoration: none;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    font-size: clamp(11px, 0.9vw, 13.5px);
    transition: background-color 0.2s ease;
  }
  #gpl-gd-svc-{{ section.id }} .gpl-gd-svc__btn:hover { background: var(--gpl-accent); }
  #gpl-gd-svc-{{ section.id }} .gpl-gd-svc__btn:focus-visible { outline: 3px solid #FFFFFF; outline-offset: 3px; }
  #gpl-gd-svc-{{ section.id }} .gpl-gd-svc__btn svg { width: 15px; height: 15px; }

  @media screen and (max-width: 1199px) {
    #gpl-gd-svc-{{ section.id }} .gpl-gd-svc__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    #gpl-gd-svc-{{ section.id }} .gpl-gd-svc-card__title { font-size: 19px; }
    #gpl-gd-svc-{{ section.id }} .gpl-gd-svc-card__desc { font-size: 13px; }
    #gpl-gd-svc-{{ section.id }} .gpl-gd-svc-card__turn { font-size: 11.5px; }
  }
  @media screen and (max-width: 749px) {
    #gpl-gd-svc-{{ section.id }} .gpl-gd-svc__grid { grid-template-columns: minmax(0, 1fr); }
    #gpl-gd-svc-{{ section.id }} .gpl-gd-svc-card { grid-template-columns: minmax(0, 0.75fr) minmax(0, 1fr); }
    #gpl-gd-svc-{{ section.id }} .gpl-gd-svc__btn { width: 100%; max-width: 420px; }
  }
  @media screen and (max-width: 419px) {
    #gpl-gd-svc-{{ section.id }} .gpl-gd-svc-card { grid-template-columns: minmax(0, 1fr); }
    #gpl-gd-svc-{{ section.id }} .gpl-gd-svc-card__media { min-height: 0; aspect-ratio: 16 / 9; }
    #gpl-gd-svc-{{ section.id }} .gpl-gd-svc-card__media img,
    #gpl-gd-svc-{{ section.id }} .gpl-gd-svc-card__media svg { position: static; }
  }
  @media (prefers-reduced-motion: reduce) {
    #gpl-gd-svc-{{ section.id }} .gpl-gd-svc__btn { transition: none; }
  }
{% endstyle %}

{% schema %}
{
  "name": "GD Services",
  "tag": "section",
  "class": "gpl-section-gd-svc",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Our" },
    { "type": "text", "id": "heading_accent", "label": "Heading accent (red)", "default": "Graphic Design" },
    { "type": "text", "id": "heading_trail", "label": "Heading, after the accent", "default": "Services" },
    { "type": "text", "id": "button_text", "label": "Button text", "default": "View All Design Examples" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "color", "id": "color_accent", "label": "Accent", "default": "#D71920" },
    { "type": "color", "id": "color_background", "label": "Background", "default": "#0A0A0A" }
  ],
  "blocks": [
    {
      "type": "service",
      "name": "Service",
      "limit": 9,
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image", "info": "Wins over the theme photo below." },
        { "type": "text", "id": "image_asset", "label": "Theme photo (assets/ filename)", "info": "gd-svc-1.jpg … gd-svc-6.jpg ship with the theme." },
        { "type": "text", "id": "title", "label": "Title", "default": "Custom" },
        { "type": "text", "id": "title_accent", "label": "Title accent (red)", "default": "T-Shirt Design" },
        { "type": "textarea", "id": "description", "label": "Description", "default": "Original artwork for apparel, streetwear, events, brands, fundraisers and more." },
        { "type": "text", "id": "turnaround", "label": "Turnaround", "default": "1-3 Business Days" }
      ]
    }
  ],
  "max_blocks": 9,
  "presets": [{ "name": "GD Services" }]
}
{% endschema %}
