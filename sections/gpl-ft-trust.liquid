{%- comment -%}
  GTA Print Lab — Fast Track Headwear page: Trust bar
  Five value props in a row. Same structural pattern as gpl-gd-why.liquid.
{%- endcomment -%}

{%- assign s = section.settings -%}

<section id="gpl-ft-trust-{{ section.id }}" class="gpl-ft-trust">
  <div class="gpl-ft-trust__inner">
    {%- if section.blocks.size > 0 -%}
      <div class="gpl-ft-trust__points">
        {%- for block in section.blocks -%}
          <div class="gpl-ft-trust-point" {{ block.shopify_attributes }}>
            {%- if block.settings.icon != blank -%}
              <span class="gpl-ft-trust-point__icon">{{ block.settings.icon }}</span>
            {%- endif -%}
            <div class="gpl-ft-trust-point__copy">
              {%- if block.settings.title != blank -%}
                <p class="gpl-ft-trust-point__title">{{ block.settings.title }}</p>
              {%- endif -%}
              {%- if block.settings.description != blank -%}
                <p class="gpl-ft-trust-point__desc">{{ block.settings.description }}</p>
              {%- endif -%}
            </div>
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% style %}
  #gpl-ft-trust-{{ section.id }} {
    --gpl-accent: {{ s.color_accent | default: '#D71920' }};
    background: {{ s.color_background | default: '#FFFFFF' }};
    border-bottom: 1px solid rgba(0, 0, 0, 0.08);
  }
  #gpl-ft-trust-{{ section.id }} .gpl-ft-trust__inner {
    box-sizing: border-box;
    width: min(1520px, calc(100% - clamp(28px, 3.2vw, 48px)));
    margin: 0 auto;
  }
  #gpl-ft-trust-{{ section.id }} .gpl-ft-trust__points {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    padding: clamp(16px, 1.8vw, 26px) 0;
  }
  #gpl-ft-trust-{{ section.id }} .gpl-ft-trust-point {
    display: flex;
    align-items: flex-start;
    gap: clamp(8px, 0.9vw, 13px);
    min-width: 0;
    padding: 0 clamp(10px, 1.2vw, 20px);
    border-left: 1px solid rgba(0, 0, 0, 0.1);
  }
  #gpl-ft-trust-{{ section.id }} .gpl-ft-trust-point:nth-child(5n + 1) { border-left: none; padding-left: 0; }
  #gpl-ft-trust-{{ section.id }} .gpl-ft-trust-point__icon { flex: 0 0 auto; display: flex; color: var(--gpl-accent); }
  #gpl-ft-trust-{{ section.id }} .gpl-ft-trust-point__icon svg { width: clamp(22px, 1.8vw, 30px); height: clamp(22px, 1.8vw, 30px); }
  #gpl-ft-trust-{{ section.id }} .gpl-ft-trust-point__copy { min-width: 0; }
  #gpl-ft-trust-{{ section.id }} .gpl-ft-trust-point__title {
    margin: 0 0 4px;
    color: #111111;
    font-weight: 800;
    text-transform: uppercase;
    font-size: clamp(10.5px, 0.76vw, 13px);
    line-height: 1.2;
    letter-spacing: 0.01em;
  }
  #gpl-ft-trust-{{ section.id }} .gpl-ft-trust-point__desc {
    margin: 0;
    color: rgba(17, 17, 17, 0.6);
    font-size: clamp(10px, 0.68vw, 11.5px);
    line-height: 1.4;
  }

  @media screen and (max-width: 1199px) {
    #gpl-ft-trust-{{ section.id }} .gpl-ft-trust__points { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 18px 0; }
    #gpl-ft-trust-{{ section.id }} .gpl-ft-trust-point:nth-child(5n + 1) { border-left: 1px solid rgba(0, 0, 0, 0.1); padding-left: clamp(10px, 1.2vw, 20px); }
    #gpl-ft-trust-{{ section.id }} .gpl-ft-trust-point:nth-child(3n + 1) { border-left: none; padding-left: 0; }
  }
  @media screen and (max-width: 749px) {
    #gpl-ft-trust-{{ section.id }} .gpl-ft-trust__points { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    #gpl-ft-trust-{{ section.id }} .gpl-ft-trust-point:nth-child(3n + 1) { border-left: 1px solid rgba(0, 0, 0, 0.1); padding-left: clamp(10px, 1.2vw, 20px); }
    #gpl-ft-trust-{{ section.id }} .gpl-ft-trust-point:nth-child(2n + 1) { border-left: none; padding-left: 0; }
  }
  @media screen and (max-width: 419px) {
    #gpl-ft-trust-{{ section.id }} .gpl-ft-trust__points { grid-template-columns: minmax(0, 1fr); }
    #gpl-ft-trust-{{ section.id }} .gpl-ft-trust-point { border-left: none !important; padding-left: 0 !important; }
  }
{% endstyle %}

{% schema %}
{
  "name": "FT Trust bar",
  "tag": "section",
  "class": "gpl-section-ft-trust",
  "settings": [
    { "type": "color", "id": "color_accent", "label": "Accent", "default": "#D71920" },
    { "type": "color", "id": "color_background", "label": "Background", "default": "#FFFFFF" }
  ],
  "blocks": [
    {
      "type": "point",
      "name": "Point",
      "limit": 5,
      "settings": [
        { "type": "html", "id": "icon", "label": "Icon (SVG code)" },
        { "type": "text", "id": "title", "label": "Title", "default": "No Minimums" },
        { "type": "textarea", "id": "description", "label": "Description", "default": "Order 1 or 1000+" }
      ]
    }
  ],
  "max_blocks": 5,
  "presets": [{ "name": "FT Trust bar" }]
}
{% endschema %}
