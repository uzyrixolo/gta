{%- comment -%}
  GTA Print Lab — About page: Mission / Goals / Team three-column block.
{%- endcomment -%}

{%- assign s = section.settings -%}

<section id="gpl-ab-mission-{{ section.id }}" class="gpl-ab-mission">
  <div class="gpl-ab-mission__inner">
    {%- for block in section.blocks -%}
      {%- assign bs = block.settings -%}
      <div class="gpl-ab-mission-col" {{ block.shopify_attributes }}>
        {%- if bs.icon != blank -%}<span class="gpl-ab-mission-col__icon">{{ bs.icon }}</span>{%- endif -%}
        {%- if bs.title != blank -%}<h3 class="gpl-ab-mission-col__title">{{ bs.title }}</h3>{%- endif -%}
        {%- if bs.text != blank -%}<div class="gpl-ab-mission-col__text">{{ bs.text }}</div>{%- endif -%}
        {%- if bs.sub_1_title != blank or bs.sub_1_items != blank -%}
          {%- assign sub_1_list = bs.sub_1_items | newline_to_br | split: '<br />' -%}
          <p class="gpl-ab-mission-col__sub">{{ bs.sub_1_title }}</p>
          <ul class="gpl-ab-mission-col__list">
            {%- for item in sub_1_list -%}
              {%- if item != blank -%}<li>{{ item | strip }}</li>{%- endif -%}
            {%- endfor -%}
          </ul>
        {%- endif -%}
        {%- if bs.sub_2_title != blank or bs.sub_2_items != blank -%}
          {%- assign sub_2_list = bs.sub_2_items | newline_to_br | split: '<br />' -%}
          <p class="gpl-ab-mission-col__sub">{{ bs.sub_2_title }}</p>
          <ul class="gpl-ab-mission-col__list">
            {%- for item in sub_2_list -%}
              {%- if item != blank -%}<li>{{ item | strip }}</li>{%- endif -%}
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>
    {%- endfor -%}
  </div>
</section>

{% style %}
  #gpl-ab-mission-{{ section.id }} {
    --gpl-accent: {{ s.color_accent | default: '#D71920' }};
    background: {{ s.color_background | default: '#0E0E0E' }};
    padding: clamp(44px, 5vw, 80px) 0;
  }
  #gpl-ab-mission-{{ section.id }} .gpl-ab-mission__inner {
    box-sizing: border-box;
    width: min(1200px, calc(100% - clamp(28px, 3.2vw, 48px)));
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(24px, 3vw, 44px);
  }
  #gpl-ab-mission-{{ section.id }} .gpl-ab-mission-col { min-width: 0; }
  #gpl-ab-mission-{{ section.id }} .gpl-ab-mission-col__icon { display: flex; color: var(--gpl-accent); margin-bottom: 12px; }
  #gpl-ab-mission-{{ section.id }} .gpl-ab-mission-col__icon svg { width: 28px; height: 28px; }
  #gpl-ab-mission-{{ section.id }} .gpl-ab-mission-col__title {
    color: #FFFFFF; font-weight: 800; text-transform: uppercase; letter-spacing: 0.02em;
    font-size: clamp(14px, 1.1vw, 16px); margin: 0 0 12px;
  }
  #gpl-ab-mission-{{ section.id }} .gpl-ab-mission-col__text {
    color: #B9B9B9; font-size: clamp(13px, 0.9vw, 14px); line-height: 1.65;
  }
  #gpl-ab-mission-{{ section.id }} .gpl-ab-mission-col__text p { margin: 0; }
  #gpl-ab-mission-{{ section.id }} .gpl-ab-mission-col__sub {
    margin: 16px 0 8px; color: var(--gpl-accent); font-size: 11px; font-weight: 800;
    text-transform: uppercase; letter-spacing: 0.05em;
  }
  #gpl-ab-mission-{{ section.id }} .gpl-ab-mission-col__list {
    margin: 0; padding: 0; list-style: none; display: flex; flex-direction: column; gap: 8px;
  }
  #gpl-ab-mission-{{ section.id }} .gpl-ab-mission-col__list li {
    color: #D9D9D9; font-size: 13px; line-height: 1.5; padding-left: 16px; position: relative;
  }
  #gpl-ab-mission-{{ section.id }} .gpl-ab-mission-col__list li::before {
    content: ''; position: absolute; left: 0; top: 8px; width: 6px; height: 6px; border-radius: 50%; background: var(--gpl-accent);
  }

  @media screen and (max-width: 749px) {
    #gpl-ab-mission-{{ section.id }} .gpl-ab-mission__inner { grid-template-columns: 1fr; gap: 32px; }
  }
{% endstyle %}

{% schema %}
{
  "name": "About: Mission/Goals/Team",
  "tag": "section",
  "class": "gpl-section-ab-mission",
  "settings": [
    { "type": "color", "id": "color_accent", "label": "Accent", "default": "#D71920" },
    { "type": "color", "id": "color_background", "label": "Background", "default": "#0E0E0E" }
  ],
  "blocks": [
    {
      "type": "column",
      "name": "Column",
      "settings": [
        { "type": "html", "id": "icon", "label": "Icon (SVG code)" },
        { "type": "text", "id": "title", "label": "Title", "default": "Our Mission" },
        { "type": "richtext", "id": "text", "label": "Text" },
        { "type": "header", "content": "Optional sub-list 1" },
        { "type": "text", "id": "sub_1_title", "label": "Sub-heading 1" },
        { "type": "textarea", "id": "sub_1_items", "label": "Items (one per line)" },
        { "type": "header", "content": "Optional sub-list 2" },
        { "type": "text", "id": "sub_2_title", "label": "Sub-heading 2" },
        { "type": "textarea", "id": "sub_2_items", "label": "Items (one per line)" }
      ]
    }
  ],
  "max_blocks": 3,
  "presets": [{ "name": "About: Mission/Goals/Team" }]
}
{% endschema %}
