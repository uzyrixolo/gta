{%- comment -%}
  GTA Print Lab — Fast Track Headwear page: Top styles grid
  Blocks are real product pickers — price/image/URL come live from Shopify.
  A per-block "Fast Track" toggle shows the badge ribbon; decoration methods
  are freeform tags (Embroidery / Patches / Print) since they aren't modelled
  as metafields on these products yet.
{%- endcomment -%}

{%- assign s = section.settings -%}

<section id="gpl-ft-products-{{ section.id }}" class="gpl-ft-products">
  <div class="gpl-ft-products__inner">
    {%- if s.heading != blank -%}
      <h2 class="gpl-ft-products__heading">{{ s.heading }}</h2>
    {%- endif -%}
    {%- if s.subheading != blank -%}
      <p class="gpl-ft-products__sub">{{ s.subheading }}</p>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="gpl-ft-products__grid">
        {%- for block in section.blocks -%}
          {%- assign p = all_products[block.settings.product_handle] -%}
          <article class="gpl-ft-product-card" {{ block.shopify_attributes }}>
            <span class="gpl-ft-product-card__num">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
            {%- if block.settings.fast_track -%}
              <span class="gpl-ft-product-card__ribbon">
                <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M13 2 3 14h7l-1 8 11-14h-7z"/></svg>
                Fast Track
              </span>
            {%- endif -%}

            {%- if p != blank -%}
              <a href="{{ p.url }}" class="gpl-ft-product-card__media">
                {%- if p.featured_image != blank -%}
                  {{
                    p.featured_image
                    | image_url: width: 700
                    | image_tag:
                      loading: 'lazy',
                      sizes: '(max-width: 749px) 45vw, (max-width: 1199px) 22vw, 15vw',
                      widths: '250, 400, 550, 700',
                      alt: p.featured_image.alt | escape
                  }}
                {%- else -%}
                  {{ 'image' | placeholder_svg_tag: 'gpl-ft-product-card__ph' }}
                {%- endif -%}
              </a>
              <div class="gpl-ft-product-card__body">
                <a href="{{ p.url }}" class="gpl-ft-product-card__title">{{ p.title }}</a>
                {%- if block.settings.subtitle != blank -%}
                  <p class="gpl-ft-product-card__subtitle">{{ block.settings.subtitle }}</p>
                {%- endif -%}
                <p class="gpl-ft-product-card__price">From {{ p.price_min | money }}</p>
                {%- if block.settings.decoration_tags != blank -%}
                  <div class="gpl-ft-product-card__tags">
                    {%- assign tags = block.settings.decoration_tags | split: ',' -%}
                    {%- for tag in tags -%}
                      <span class="gpl-ft-product-card__tag">{{ tag | strip }}</span>
                    {%- endfor -%}
                  </div>
                {%- endif -%}
                <a href="{{ p.url }}" class="gpl-ft-product-card__cta">
                  <span>Customize</span>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M5 12h14M13 5l7 7-7 7"/>
                  </svg>
                </a>
              </div>
            {%- else -%}
              <div class="gpl-ft-product-card__body">
                <p class="gpl-ft-product-card__title">Select a product</p>
              </div>
            {%- endif -%}
          </article>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if s.button_text != blank -%}
      <div class="gpl-ft-products__cta">
        <a href="{{ s.button_link | default: '#' }}" class="gpl-ft-products__btn">
          <span>{{ s.button_text }}</span>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M5 12h14M13 5l7 7-7 7"/>
          </svg>
        </a>
      </div>
    {%- endif -%}
  </div>
</section>

{% style %}
  #gpl-ft-products-{{ section.id }} {
    --gpl-accent: {{ s.color_accent | default: '#D71920' }};
    background: {{ s.color_background | default: '#FFFFFF' }};
    padding: clamp(34px, 4vw, 58px) 0;
  }
  #gpl-ft-products-{{ section.id }} .gpl-ft-products__inner {
    box-sizing: border-box;
    width: min(1520px, calc(100% - clamp(28px, 3.2vw, 48px)));
    margin: 0 auto;
  }
  #gpl-ft-products-{{ section.id }} .gpl-ft-products__heading {
    margin: 0 0 6px;
    text-align: center;
    color: #111111;
    font-family: var(--gpl-font-heading, inherit);
    font-weight: 800;
    text-transform: uppercase;
    line-height: 1.05;
    letter-spacing: -0.005em;
    font-size: clamp(22px, 2.6vw, 38px);
  }
  #gpl-ft-products-{{ section.id }} .gpl-ft-products__sub {
    margin: 0 0 clamp(20px, 2.2vw, 32px);
    text-align: center;
    color: rgba(17, 17, 17, 0.6);
    font-size: clamp(12.5px, 0.9vw, 14.5px);
  }

  #gpl-ft-products-{{ section.id }} .gpl-ft-products__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(12px, 1.2vw, 18px);
  }
  #gpl-ft-products-{{ section.id }} .gpl-ft-product-card {
    position: relative;
    display: flex;
    flex-direction: column;
    background: #FFFFFF;
    border: 1px solid rgba(0, 0, 0, 0.1);
    border-radius: 6px;
    overflow: hidden;
    min-width: 0;
  }
  #gpl-ft-products-{{ section.id }} .gpl-ft-product-card__num {
    position: absolute;
    top: 10px;
    left: 10px;
    z-index: 2;
    background: rgba(17, 17, 17, 0.85);
    color: #FFFFFF;
    font-weight: 800;
    font-size: 11px;
    line-height: 1;
    padding: 5px 7px;
    border-radius: 3px;
  }
  #gpl-ft-products-{{ section.id }} .gpl-ft-product-card__ribbon {
    position: absolute;
    top: 10px;
    right: 10px;
    z-index: 2;
    display: flex;
    align-items: center;
    gap: 4px;
    background: var(--gpl-accent);
    color: #FFFFFF;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    font-size: 9.5px;
    padding: 5px 8px;
    border-radius: 3px;
  }
  #gpl-ft-products-{{ section.id }} .gpl-ft-product-card__ribbon svg { width: 10px; height: 10px; }

  #gpl-ft-products-{{ section.id }} .gpl-ft-product-card__media {
    position: relative;
    display: block;
    aspect-ratio: 1 / 1;
    background: #F3F3F3;
  }
  #gpl-ft-products-{{ section.id }} .gpl-ft-product-card__media img,
  #gpl-ft-products-{{ section.id }} .gpl-ft-product-card__media svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  #gpl-ft-products-{{ section.id }} .gpl-ft-product-card__ph { fill: rgba(0,0,0,0.2); }

  #gpl-ft-products-{{ section.id }} .gpl-ft-product-card__body {
    display: flex;
    flex-direction: column;
    padding: clamp(12px, 1.1vw, 16px);
    min-width: 0;
  }
  #gpl-ft-products-{{ section.id }} .gpl-ft-product-card__title {
    margin: 0 0 2px;
    color: #111111;
    font-weight: 800;
    text-transform: uppercase;
    line-height: 1.2;
    font-size: clamp(12.5px, 0.9vw, 14px);
    text-decoration: none;
  }
  #gpl-ft-products-{{ section.id }} .gpl-ft-product-card__subtitle {
    margin: 0 0 8px;
    color: rgba(17, 17, 17, 0.55);
    font-size: clamp(11px, 0.76vw, 12.5px);
  }
  #gpl-ft-products-{{ section.id }} .gpl-ft-product-card__price {
    margin: 0 0 10px;
    color: #111111;
    font-weight: 700;
    font-size: clamp(12.5px, 0.9vw, 14px);
  }
  #gpl-ft-products-{{ section.id }} .gpl-ft-product-card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 5px;
    margin: 0 0 12px;
  }
  #gpl-ft-products-{{ section.id }} .gpl-ft-product-card__tag {
    background: #F1F1F1;
    color: rgba(17, 17, 17, 0.7);
    font-size: 10px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    padding: 3px 7px;
    border-radius: 3px;
  }
  #gpl-ft-products-{{ section.id }} .gpl-ft-product-card__cta {
    margin-top: auto;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    background: var(--gpl-accent);
    color: #FFFFFF;
    text-decoration: none;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    font-size: clamp(11px, 0.8vw, 12.5px);
    padding: 11px 14px;
    border-radius: 4px;
    transition: background-color 0.2s ease;
  }
  #gpl-ft-products-{{ section.id }} .gpl-ft-product-card__cta:hover { background: #B5141A; }
  #gpl-ft-products-{{ section.id }} .gpl-ft-product-card__cta svg { width: 14px; height: 14px; }

  #gpl-ft-products-{{ section.id }} .gpl-ft-products__cta { margin-top: clamp(18px, 2vw, 28px); text-align: center; }
  #gpl-ft-products-{{ section.id }} .gpl-ft-products__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 13px 28px;
    border: 2px solid var(--gpl-accent);
    border-radius: 5px;
    background: transparent;
    color: #111111;
    text-decoration: none;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    font-size: clamp(11px, 0.9vw, 13.5px);
    transition: background-color 0.2s ease, color 0.2s ease;
  }
  #gpl-ft-products-{{ section.id }} .gpl-ft-products__btn:hover { background: var(--gpl-accent); color: #FFFFFF; }
  #gpl-ft-products-{{ section.id }} .gpl-ft-products__btn:focus-visible { outline: 3px solid #111111; outline-offset: 3px; }
  #gpl-ft-products-{{ section.id }} .gpl-ft-products__btn svg { width: 15px; height: 15px; }

  @media screen and (max-width: 989px) {
    #gpl-ft-products-{{ section.id }} .gpl-ft-products__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media screen and (max-width: 419px) {
    #gpl-ft-products-{{ section.id }} .gpl-ft-products__grid { grid-template-columns: minmax(0, 1fr); }
  }
  @media (prefers-reduced-motion: reduce) {
    #gpl-ft-products-{{ section.id }} .gpl-ft-product-card__cta,
    #gpl-ft-products-{{ section.id }} .gpl-ft-products__btn { transition: none; }
  }
{% endstyle %}

{% schema %}
{
  "name": "FT Products",
  "tag": "section",
  "class": "gpl-section-ft-products",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Top Fast Track Headwear Styles" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "The most popular hats for your brand, team, event or merchandise." },
    { "type": "text", "id": "button_text", "label": "Button text", "default": "View All Headwear" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "color", "id": "color_accent", "label": "Accent", "default": "#D71920" },
    { "type": "color", "id": "color_background", "label": "Background", "default": "#FFFFFF" }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "limit": 8,
      "settings": [
        { "type": "text", "id": "product_handle", "label": "Product handle" },
        { "type": "text", "id": "subtitle", "label": "Style subtitle", "default": "Classic Trucker Cap" },
        { "type": "text", "id": "decoration_tags", "label": "Decoration tags", "info": "Comma-separated, e.g. Embroidery, Patches, Print", "default": "Embroidery, Patches, Print" },
        { "type": "checkbox", "id": "fast_track", "label": "Show Fast Track badge", "default": true }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [{ "name": "FT Products" }]
}
{% endschema %}
