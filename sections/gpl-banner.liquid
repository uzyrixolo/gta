{%- comment -%}
  GTA Print Lab — artwork banner.

  For the finished banners the client supplies: the headline, the sub-copy and
  the buttons are already drawn into the image, so this section adds no text of
  its own — it just places the picture at full width and never crops it, at any
  screen size (width: 100%, height: auto).

  Two things the picture cannot do on its own, which this section adds:

  * a real heading. The banner's headline is pixels, invisible to search engines
    and screen readers, so the heading text is repeated here visually hidden.
  * real buttons. A button drawn into the artwork is not clickable, so a
    "Clickable area" block puts a transparent link over it, positioned in
    percentages — which stay true because the image is never cropped.
{%- endcomment -%}

{%- assign s = section.settings -%}
{%- assign id = section.id -%}
{%- assign img = s.image -%}
{%- assign hotspots = section.blocks | where: 'type', 'hotspot' -%}

{%- if img != blank -%}
  <section id="gpl-banner-{{ id }}" class="gpl-banner{% if s.full_bleed %} gpl-banner--bleed{% endif %}">
    {%- if s.heading != blank -%}
      <{{ s.heading_level }} class="gpl-banner__sr-heading">{{ s.heading }}</{{ s.heading_level }}>
    {%- endif -%}

    <div class="gpl-banner__inner">
      {%- capture banner_media -%}
        <img class="gpl-banner__img{% if s.image_mobile != blank %} gpl-banner__img--desktop{% endif %}"
          src="{{ img | image_url: width: 2400 }}"
          srcset="{{ img | image_url: width: 900 }} 900w, {{ img | image_url: width: 1400 }} 1400w, {{ img | image_url: width: 1800 }} 1800w, {{ img | image_url: width: 2400 }} 2400w"
          sizes="100vw"
          alt="{{ s.alt | default: s.heading | escape }}"
          width="{{ img.width }}" height="{{ img.height }}"
          {% if s.eager %}loading="eager" fetchpriority="high"{% else %}loading="lazy"{% endif %}>
        {%- if s.image_mobile != blank -%}
          <img class="gpl-banner__img gpl-banner__img--mobile"
            src="{{ s.image_mobile | image_url: width: 1200 }}"
            srcset="{{ s.image_mobile | image_url: width: 600 }} 600w, {{ s.image_mobile | image_url: width: 900 }} 900w, {{ s.image_mobile | image_url: width: 1200 }} 1200w"
            sizes="100vw"
            alt="{{ s.alt | default: s.heading | escape }}"
            width="{{ s.image_mobile.width }}" height="{{ s.image_mobile.height }}"
            {% if s.eager %}loading="eager" fetchpriority="high"{% else %}loading="lazy"{% endif %}>
        {%- endif -%}
      {%- endcapture -%}

      <div class="gpl-banner__frame">
        {%- if s.link != blank and hotspots.size == 0 -%}
          <a class="gpl-banner__link" href="{{ s.link }}" aria-label="{{ s.alt | default: s.heading | escape }}">{{ banner_media }}</a>
        {%- else -%}
          {{ banner_media }}
        {%- endif -%}

        {%- for block in hotspots -%}
          {%- assign h = block.settings -%}
          {%- if h.link != blank -%}
            <a class="gpl-banner__hotspot{% if request.design_mode %} is-outlined{% endif %}"
              href="{{ h.link }}"
              aria-label="{{ h.label | escape }}"
              style="left: {{ h.x }}%; top: {{ h.y }}%; width: {{ h.w }}%; height: {{ h.h }}%;"
              {{ block.shopify_attributes }}>
              <span class="gpl-banner__sr-heading">{{ h.label }}</span>
            </a>
          {%- endif -%}
        {%- endfor -%}
      </div>

      {%- if s.button_1_text != blank or s.button_2_text != blank or s.button_3_text != blank -%}
        <div class="gpl-banner__buttons">
          {%- if s.button_1_text != blank -%}
            <a class="gpl-banner__btn gpl-banner__btn--primary" href="{{ s.button_1_link | default: '#' }}">
              {{ s.button_1_text }}
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
            </a>
          {%- endif -%}
          {%- if s.button_2_text != blank -%}
            <a class="gpl-banner__btn gpl-banner__btn--outline" href="{{ s.button_2_link | default: '#' }}">{{ s.button_2_text }}</a>
          {%- endif -%}
          {%- if s.button_3_text != blank -%}
            <a class="gpl-banner__btn gpl-banner__btn--outline" href="{{ s.button_3_link | default: '#' }}">{{ s.button_3_text }}</a>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </section>
{%- elsif request.design_mode -%}
  <section class="gpl-banner gpl-banner--empty"><p>Pick a banner image for this section.</p></section>
{%- endif -%}

{% style %}
  #gpl-banner-{{ id }} {
    background: {{ s.color_background }};
    padding: {{ s.padding_top }}px 0 {{ s.padding_bottom }}px;
  }
  #gpl-banner-{{ id }} .gpl-banner__inner {
    max-width: {% if s.full_bleed %}none{% else %}{{ s.max_width }}px{% endif %};
    margin: 0 auto;
    padding: 0 {% if s.full_bleed %}0{% else %}{{ s.side_padding }}px{% endif %};
  }
  /* the frame is the positioning context for the clickable areas, and it is
     exactly the size of the picture because the picture is never cropped */
  #gpl-banner-{{ id }} .gpl-banner__frame { position: relative; line-height: 0; border-radius: {{ s.corner_radius }}px; overflow: hidden; }
  #gpl-banner-{{ id }} .gpl-banner__link { display: block; }
  #gpl-banner-{{ id }} .gpl-banner__img { display: block; width: 100%; height: auto; }
  {%- if s.image_mobile != blank %}
  #gpl-banner-{{ id }} .gpl-banner__img--mobile { display: none; }
  @media screen and (max-width: 749px) {
    #gpl-banner-{{ id }} .gpl-banner__img--desktop { display: none; }
    #gpl-banner-{{ id }} .gpl-banner__img--mobile { display: block; }
  }
  {%- endif %}

  #gpl-banner-{{ id }} .gpl-banner__hotspot { position: absolute; display: block; border-radius: 6px; }
  #gpl-banner-{{ id }} .gpl-banner__hotspot:focus-visible { outline: 3px solid #FFFFFF; outline-offset: 2px; }
  #gpl-banner-{{ id }} .gpl-banner__hotspot.is-outlined { outline: 2px dashed rgba(255,255,255,0.85); background: rgba(215,25,32,0.2); }

  #gpl-banner-{{ id }} .gpl-banner__sr-heading {
    position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
    overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0;
  }

  #gpl-banner-{{ id }} .gpl-banner__buttons { display: flex; flex-wrap: wrap; gap: 12px; justify-content: {{ s.button_align }}; margin-top: 22px; }
  #gpl-banner-{{ id }} .gpl-banner__btn {
    display: inline-flex; align-items: center; gap: 8px; padding: 14px 26px; border-radius: 999px;
    font-weight: 700; font-size: 13.5px; letter-spacing: .02em; text-transform: uppercase;
    text-decoration: none; border: 2px solid transparent; transition: background-color .2s ease, border-color .2s ease, color .2s ease;
  }
  #gpl-banner-{{ id }} .gpl-banner__btn--primary { background: {{ s.color_accent }}; color: #FFFFFF; }
  #gpl-banner-{{ id }} .gpl-banner__btn--primary:hover { filter: brightness(0.88); }
  #gpl-banner-{{ id }} .gpl-banner__btn--outline { color: {{ s.color_button_text }}; border-color: {{ s.color_button_text }}; }
  #gpl-banner-{{ id }} .gpl-banner__btn--outline:hover { background: {{ s.color_accent }}; border-color: {{ s.color_accent }}; color: #FFFFFF; }

  @media screen and (max-width: 749px) {
    #gpl-banner-{{ id }} { padding: {{ s.padding_top | divided_by: 2 }}px 0 {{ s.padding_bottom | divided_by: 2 }}px; }
    #gpl-banner-{{ id }} .gpl-banner__inner { padding: 0 {% if s.full_bleed %}0{% else %}16{% endif %}px; }
    #gpl-banner-{{ id }} .gpl-banner__buttons { flex-direction: column; }
    #gpl-banner-{{ id }} .gpl-banner__btn { justify-content: center; }
  }
{% endstyle %}

{% schema %}
{
  "name": "GPL Banner",
  "tag": "section",
  "class": "gpl-section-banner",
  "settings": [
    {
      "type": "paragraph",
      "content": "For finished artwork that already carries its own headline and buttons. The image is shown in full and never cropped; add \"Clickable area\" blocks to make the buttons drawn into it work."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Banner image"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Banner image (mobile)",
      "info": "Optional. A wide banner stays readable on phones only if you supply a taller crop of it."
    },
    {
      "type": "text",
      "id": "alt",
      "label": "Alt text",
      "info": "Describe what the banner says — this is what a screen reader reads out."
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link for the whole banner",
      "info": "Ignored when the banner has clickable areas."
    },
    {
      "type": "checkbox",
      "id": "eager",
      "label": "Load immediately",
      "default": false,
      "info": "Turn on for the first banner on a page."
    },
    {
      "type": "header",
      "content": "Heading for search engines and screen readers"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading text",
      "info": "The banner's headline as text. Not shown on screen — the artwork already shows it."
    },
    {
      "type": "select",
      "id": "heading_level",
      "label": "Heading level",
      "default": "h1",
      "options": [
        {
          "value": "h1",
          "label": "H1 — the page's main heading"
        },
        {
          "value": "h2",
          "label": "H2 — a section heading"
        }
      ]
    },
    {
      "type": "header",
      "content": "Buttons under the banner"
    },
    {
      "type": "text",
      "id": "button_1_text",
      "label": "Button 1 text"
    },
    {
      "type": "url",
      "id": "button_1_link",
      "label": "Button 1 link"
    },
    {
      "type": "text",
      "id": "button_2_text",
      "label": "Button 2 text"
    },
    {
      "type": "url",
      "id": "button_2_link",
      "label": "Button 2 link"
    },
    {
      "type": "text",
      "id": "button_3_text",
      "label": "Button 3 text"
    },
    {
      "type": "url",
      "id": "button_3_link",
      "label": "Button 3 link"
    },
    {
      "type": "select",
      "id": "button_align",
      "label": "Button alignment",
      "default": "center",
      "options": [
        {
          "value": "flex-start",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Centre"
        },
        {
          "value": "flex-end",
          "label": "Right"
        }
      ]
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "checkbox",
      "id": "full_bleed",
      "label": "Full width (edge to edge)",
      "default": true
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Maximum width",
      "min": 800,
      "max": 1800,
      "step": 20,
      "unit": "px",
      "default": 1440
    },
    {
      "type": "range",
      "id": "side_padding",
      "label": "Side padding",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "corner_radius",
      "label": "Corner radius",
      "min": 0,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "Colours"
    },
    {
      "type": "color",
      "id": "color_background",
      "label": "Background",
      "default": "#0B0B0B"
    },
    {
      "type": "color",
      "id": "color_accent",
      "label": "Accent",
      "default": "#D71920"
    },
    {
      "type": "color",
      "id": "color_button_text",
      "label": "Outline button text",
      "default": "#FFFFFF"
    }
  ],
  "blocks": [
    {
      "type": "hotspot",
      "name": "Clickable area",
      "limit": 8,
      "settings": [
        {
          "type": "paragraph",
          "content": "Put a link over a button drawn into the artwork. Positions are percentages of the image, measured from its top-left corner; while you are in the theme editor each area is outlined so you can line it up."
        },
        {
          "type": "text",
          "id": "label",
          "label": "What the button says",
          "default": "Learn more"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "range",
          "id": "x",
          "label": "Left",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "default": 10
        },
        {
          "type": "range",
          "id": "y",
          "label": "Top",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "default": 70
        },
        {
          "type": "range",
          "id": "w",
          "label": "Width",
          "min": 1,
          "max": 100,
          "step": 1,
          "unit": "%",
          "default": 18
        },
        {
          "type": "range",
          "id": "h",
          "label": "Height",
          "min": 1,
          "max": 100,
          "step": 1,
          "unit": "%",
          "default": 10
        }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "GPL Banner"
    }
  ]
}
{% endschema %}
