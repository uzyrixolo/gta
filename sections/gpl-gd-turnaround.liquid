{%- comment -%}
  GTA Print Lab — Graphic Design page: Turnaround & pricing tiers (M4)
{%- endcomment -%}

{%- assign s = section.settings -%}

<section id="gpl-gd-turn-{{ section.id }}" class="gpl-gd-turn">
  <div class="gpl-gd-turn__inner">
    {%- if s.heading != blank -%}
      <h2 class="gpl-gd-turn__heading">{{ s.heading }}</h2>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="gpl-gd-turn__panel">
        {%- for block in section.blocks -%}
          <div class="gpl-gd-turn-tier" {{ block.shopify_attributes }}>
            {%- if block.settings.icon != blank -%}
              <span class="gpl-gd-turn-tier__icon">{{ block.settings.icon }}</span>
            {%- endif -%}
            <div class="gpl-gd-turn-tier__copy">
              {%- if block.settings.label != blank -%}
                <p class="gpl-gd-turn-tier__label">{{ block.settings.label }}</p>
              {%- endif -%}
              {%- if block.settings.title != blank -%}
                <p class="gpl-gd-turn-tier__title">{{ block.settings.title }}</p>
              {%- endif -%}
              {%- if block.settings.description != blank -%}
                <p class="gpl-gd-turn-tier__desc">{{ block.settings.description }}</p>
              {%- endif -%}
              {%- if block.settings.price != blank -%}
                <p class="gpl-gd-turn-tier__price">{{ block.settings.price }}</p>
              {%- endif -%}
            </div>
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if s.footnote != blank -%}
      <p class="gpl-gd-turn__footnote">{{ s.footnote }}</p>
    {%- endif -%}
  </div>
</section>

{% style %}
  #gpl-gd-turn-{{ section.id }} {
    --gpl-accent: {{ s.color_accent | default: '#D71920' }};
    background: {{ s.color_background | default: '#0A0A0A' }};
    padding: 0 0 clamp(30px, 3.4vw, 50px);
  }
  #gpl-gd-turn-{{ section.id }} .gpl-gd-turn__inner {
    box-sizing: border-box;
    width: min(1520px, calc(100% - clamp(28px, 3.2vw, 48px)));
    margin: 0 auto;
  }
  #gpl-gd-turn-{{ section.id }} .gpl-gd-turn__heading {
    margin: 0 0 clamp(16px, 1.8vw, 26px);
    text-align: center;
    color: #FFFFFF;
    font-family: var(--gpl-font-heading, inherit);
    font-weight: 800;
    text-transform: uppercase;
    line-height: 1.05;
    letter-spacing: -0.005em;
    font-size: clamp(20px, 2.4vw, 34px);
  }
  #gpl-gd-turn-{{ section.id }} .gpl-gd-turn__panel {
    background: #141414;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 6px;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    padding: clamp(14px, 1.5vw, 22px) clamp(6px, 0.8vw, 12px);
  }
  #gpl-gd-turn-{{ section.id }} .gpl-gd-turn-tier {
    display: flex;
    align-items: flex-start;
    gap: clamp(10px, 1vw, 15px);
    min-width: 0;
    padding: clamp(4px, 0.5vw, 8px) clamp(12px, 1.4vw, 22px);
    border-left: 1px solid rgba(255, 255, 255, 0.14);
  }
  #gpl-gd-turn-{{ section.id }} .gpl-gd-turn-tier:nth-child(4n + 1) { border-left: none; }
  #gpl-gd-turn-{{ section.id }} .gpl-gd-turn-tier__icon { flex: 0 0 auto; display: flex; color: var(--gpl-accent); }
  #gpl-gd-turn-{{ section.id }} .gpl-gd-turn-tier__icon svg {
    width: clamp(28px, 2.4vw, 40px);
    height: clamp(28px, 2.4vw, 40px);
  }
  #gpl-gd-turn-{{ section.id }} .gpl-gd-turn-tier__copy { min-width: 0; }
  #gpl-gd-turn-{{ section.id }} .gpl-gd-turn-tier__label {
    margin: 0 0 3px;
    color: #9C9C9C;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    font-size: clamp(9.5px, 0.66vw, 11px);
  }
  #gpl-gd-turn-{{ section.id }} .gpl-gd-turn-tier__title {
    margin: 0 0 6px;
    color: #FFFFFF;
    font-family: var(--gpl-font-heading, inherit);
    font-weight: 800;
    text-transform: uppercase;
    line-height: 1.08;
    font-size: clamp(14px, 1.25vw, 21px);
  }
  #gpl-gd-turn-{{ section.id }} .gpl-gd-turn-tier__desc {
    margin: 0 0 7px;
    color: #9C9C9C;
    font-size: clamp(10px, 0.7vw, 12px);
    line-height: 1.45;
  }
  #gpl-gd-turn-{{ section.id }} .gpl-gd-turn-tier__price {
    margin: 0;
    color: var(--gpl-accent);
    font-weight: 800;
    font-size: clamp(10.5px, 0.72vw, 12.5px);
  }
  #gpl-gd-turn-{{ section.id }} .gpl-gd-turn__footnote {
    margin: clamp(10px, 1vw, 15px) 0 0;
    text-align: center;
    color: #8A8A8A;
    font-size: clamp(10px, 0.7vw, 12px);
  }

  @media screen and (max-width: 1199px) {
    #gpl-gd-turn-{{ section.id }} .gpl-gd-turn__panel { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 18px 0; }
    #gpl-gd-turn-{{ section.id }} .gpl-gd-turn-tier:nth-child(2n + 1) { border-left: none; }
    #gpl-gd-turn-{{ section.id }} .gpl-gd-turn-tier:nth-child(2n) { border-left: 1px solid rgba(255, 255, 255, 0.14); }
    #gpl-gd-turn-{{ section.id }} .gpl-gd-turn-tier__desc { font-size: 12px; }
  }
  @media screen and (max-width: 549px) {
    #gpl-gd-turn-{{ section.id }} .gpl-gd-turn__panel { grid-template-columns: minmax(0, 1fr); gap: 16px; }
    #gpl-gd-turn-{{ section.id }} .gpl-gd-turn-tier { border-left: none !important; }
  }
{% endstyle %}

{% schema %}
{
  "name": "GD Turnaround",
  "tag": "section",
  "class": "gpl-section-gd-turn",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "How Long Does Graphic Design Take?" },
    { "type": "text", "id": "footnote", "label": "Footnote", "default": "Turnaround times depend on project complexity and current production volume." },
    { "type": "color", "id": "color_accent", "label": "Accent", "default": "#D71920" },
    { "type": "color", "id": "color_background", "label": "Background", "default": "#0A0A0A" }
  ],
  "blocks": [
    {
      "type": "tier",
      "name": "Tier",
      "limit": 4,
      "settings": [
        { "type": "html", "id": "icon", "label": "Icon (SVG code)" },
        { "type": "text", "id": "label", "label": "Label", "default": "Express Design" },
        { "type": "text", "id": "title", "label": "Turnaround", "default": "Same Day" },
        { "type": "textarea", "id": "description", "label": "Description", "default": "For simple changes, text edits, background removal and print-ready artwork." },
        { "type": "text", "id": "price", "label": "Price", "default": "Starting at $25" }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [{ "name": "GD Turnaround" }]
}
{% endschema %}
