{%- comment -%}
  GTA Print Lab — How It Works (revamped)
  Section type: image-with-text  (legacy filename, kept so existing templates keep working)

  Structure
    1. Hero band   — eyebrow + two-tone heading + intro line over a background image
    2. Step cards  — up to 4 "step" blocks (auto-numbered ribbon, image, badge icon, copy, timing chip)
    3. Feature bar — up to 4 "feature" blocks
    4. CTA button

  Images are optional everywhere — blank pickers fall back to placeholders.
{%- endcomment -%}

{%- assign s = section.settings -%}

<section class="gpl-how-{{ section.id }} gpl-how">
  <div class="gpl-how__hero">
    {%- if s.hero_image != blank -%}
      <div class="gpl-how__hero-bg">
        {{
          s.hero_image
          | image_url: width: 2400
          | image_tag:
            loading: 'lazy',
            sizes: '100vw',
            widths: '750, 1100, 1500, 1900, 2400',
            alt: s.hero_image.alt | escape
        }}
      </div>
    {%- endif -%}

    <div class="gpl-how__hero-inner">
      {%- if s.eyebrow != blank -%}
        <p class="gpl-how__eyebrow">{{ s.eyebrow }}</p>
      {%- endif -%}

      <h2 class="gpl-how__heading">
        {%- if s.heading_light != blank -%}
          <span class="gpl-how__heading-light">{{ s.heading_light }}</span>
        {%- endif -%}
        {%- if s.heading_accent != blank -%}
          <span class="gpl-how__heading-accent">{{ s.heading_accent }}</span>
        {%- endif -%}
      </h2>

      {%- if s.intro != blank -%}
        <p class="gpl-how__intro">{{ s.intro }}</p>
      {%- endif -%}
    </div>
  </div>

  {%- assign step_blocks = section.blocks | where: 'type', 'step' -%}
  {%- if step_blocks.size > 0 -%}
    <div class="gpl-how__steps">
      {%- for block in step_blocks -%}
        {%- assign step_no = forloop.index -%}
        <article class="gpl-how-card" {{ block.shopify_attributes }}>
          <div class="gpl-how-card__media">
            <div class="gpl-how-card__frame">
              {%- if block.settings.image != blank -%}
                {{
                  block.settings.image
                  | image_url: width: 900
                  | image_tag:
                    loading: 'lazy',
                    sizes: '(max-width: 749px) 92vw, (max-width: 989px) 46vw, 24vw',
                    widths: '400, 600, 750, 900',
                    alt: block.settings.image.alt | escape
                }}
              {%- else -%}
                {{ 'image' | placeholder_svg_tag: 'gpl-how-card__ph' }}
              {%- endif -%}
            </div>

            <span class="gpl-how-card__num" aria-hidden="true">
              <i>{% if step_no < 10 %}0{% endif %}{{ step_no }}</i>
            </span>

            {%- if block.settings.icon != blank -%}
              <span class="gpl-how-card__badge">{{ block.settings.icon }}</span>
            {%- endif -%}

            {%- unless forloop.last -%}
              <span class="gpl-how-card__chev" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M9 5l7 7-7 7"/>
                </svg>
              </span>
            {%- endunless -%}
          </div>

          <div class="gpl-how-card__body">
            {%- if block.settings.title != blank -%}
              <h3 class="gpl-how-card__title">{{ block.settings.title }}</h3>
            {%- endif -%}
            {%- if block.settings.description != blank -%}
              <p class="gpl-how-card__desc">{{ block.settings.description }}</p>
            {%- endif -%}
          </div>

          {%- if block.settings.chip_text != blank -%}
            <div class="gpl-how-card__chipwrap">
              <span class="gpl-how-card__chip">
                {%- if block.settings.chip_icon != blank -%}
                  <span class="gpl-how-card__chip-icon">{{ block.settings.chip_icon }}</span>
                {%- endif -%}
                <span class="gpl-how-card__chip-text">{{ block.settings.chip_text }}</span>
              </span>
            </div>
          {%- endif -%}
        </article>
      {%- endfor -%}
    </div>
  {%- endif -%}

  {%- assign feature_blocks = section.blocks | where: 'type', 'feature' -%}
  {%- if feature_blocks.size > 0 -%}
    <div class="gpl-how__features">
      {%- for block in feature_blocks -%}
        <div class="gpl-how-feature" {{ block.shopify_attributes }}>
          {%- if block.settings.icon != blank -%}
            <span class="gpl-how-feature__icon">{{ block.settings.icon }}</span>
          {%- endif -%}
          <div class="gpl-how-feature__copy">
            {%- if block.settings.title != blank -%}
              <p class="gpl-how-feature__title">{{ block.settings.title }}</p>
            {%- endif -%}
            {%- if block.settings.description != blank -%}
              <p class="gpl-how-feature__desc">{{ block.settings.description }}</p>
            {%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    </div>
  {%- endif -%}

  {%- if s.button_text != blank -%}
    <div class="gpl-how__cta">
      <a href="{{ s.button_link | default: '#' }}" class="gpl-how__btn">
        {%- if s.button_icon != blank -%}
          <span class="gpl-how__btn-icon">{{ s.button_icon }}</span>
        {%- endif -%}
        <span>{{ s.button_text }}</span>
        <svg
          class="gpl-how__btn-arrow"
          width="22"
          height="22"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M5 12h14M13 5l7 7-7 7"/>
        </svg>
      </a>
    </div>
  {%- endif -%}
</section>

{% style %}
  .gpl-how-{{ section.id }} {
    --gpl-red: {{ s.color_accent | default: '#D71920' }};
    --gpl-ink: #111111;
    --gpl-radius: 14px;
    --gpl-gutter: clamp(14px, 1.6vw, 24px);
    --gpl-shell: min(1520px, calc(100% - var(--gpl-gutter) * 2));
    background: {{ s.color_background | default: '#0A0A0A' }};
    padding: 0 0 clamp(28px, 3vw, 44px);
  }

  /* ---------- 1. Hero band ---------- */
  .gpl-how-{{ section.id }} .gpl-how__hero {
    position: relative;
    overflow: hidden;
    padding: clamp(30px, 4vw, 56px) 20px clamp(22px, 2.8vw, 38px);
    text-align: center;
  }
  .gpl-how-{{ section.id }} .gpl-how__hero-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }
  .gpl-how-{{ section.id }} .gpl-how__hero-bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.5;
  }
  .gpl-how-{{ section.id }} .gpl-how__hero::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    background: radial-gradient(ellipse at center, rgba(10,10,10,0.8) 0%, rgba(10,10,10,0.93) 62%, #0A0A0A 100%);
  }
  .gpl-how-{{ section.id }} .gpl-how__hero-inner {
    position: relative;
    z-index: 2;
    max-width: 1180px;
    margin: 0 auto;
  }
  .gpl-how-{{ section.id }} .gpl-how__eyebrow {
    color: var(--gpl-red);
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    font-size: clamp(11px, 1.35vw, 17px);
    line-height: 1;
    margin: 0 0 clamp(4px, 0.5vw, 8px);
  }
  .gpl-how-{{ section.id }} .gpl-how__heading {
    margin: 0;
    font-family: var(--gpl-font-heading, inherit);
    font-weight: 800;
    text-transform: uppercase;
    line-height: 0.98;
    letter-spacing: -0.01em;
    font-size: clamp(22px, 4vw, 52px);
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0 0.24em;
  }
  .gpl-how-{{ section.id }} .gpl-how__heading-light { color: #FFFFFF; }
  .gpl-how-{{ section.id }} .gpl-how__heading-accent { color: var(--gpl-red); }
  .gpl-how-{{ section.id }} .gpl-how__intro {
    position: relative;
    color: #E8E8E8;
    font-weight: 500;
    font-size: clamp(11px, 0.95vw, 14px);
    line-height: 1.45;
    margin: clamp(10px, 1.2vw, 16px) auto 0;
    padding-top: clamp(9px, 1vw, 14px);
    max-width: 62ch;
  }
  .gpl-how-{{ section.id }} .gpl-how__intro::before {
    content: '';
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: clamp(180px, 40vw, 640px);
    height: 2px;
    background: var(--gpl-red);
  }

  /* ---------- 2. Step cards ---------- */
  .gpl-how-{{ section.id }} .gpl-how__steps {
    box-sizing: border-box;
    width: var(--gpl-shell);
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(14px, 1.4vw, 22px);
    align-items: stretch;
  }
  .gpl-how-{{ section.id }} .gpl-how-card {
    position: relative;
    display: flex;
    flex-direction: column;
    background: #FFFFFF;
    border-radius: var(--gpl-radius);
  }
  .gpl-how-{{ section.id }} .gpl-how-card__media {
    position: relative;
    flex: 0 0 auto;
  }
  .gpl-how-{{ section.id }} .gpl-how-card__frame {
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: var(--gpl-radius) var(--gpl-radius) 0 0;
    background: #1a1a1a;
  }
  .gpl-how-{{ section.id }} .gpl-how-card__frame img,
  .gpl-how-{{ section.id }} .gpl-how-card__frame svg {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .gpl-how-{{ section.id }} .gpl-how-card__ph {
    background: #2a2a2a;
    fill: rgba(255, 255, 255, 0.28);
  }

  /* corner ribbon with the auto step number */
  .gpl-how-{{ section.id }} .gpl-how-card__num {
    position: absolute;
    top: 0;
    left: 0;
    z-index: 2;
    width: clamp(52px, 4.6vw, 70px);
    height: clamp(52px, 4.6vw, 70px);
    border-radius: var(--gpl-radius) 0 0 0;
    background: linear-gradient(135deg, var(--gpl-red) 0 50%, transparent 50.1%);
    pointer-events: none;
  }
  .gpl-how-{{ section.id }} .gpl-how-card__num i {
    position: absolute;
    top: clamp(3px, 0.35vw, 6px);
    left: clamp(7px, 0.7vw, 11px);
    font-style: normal;
    font-weight: 800;
    color: #FFFFFF;
    font-size: clamp(11px, 0.95vw, 15px);
    line-height: 1;
  }

  .gpl-how-{{ section.id }} .gpl-how-card__badge {
    position: absolute;
    left: 50%;
    bottom: 0;
    transform: translate(-50%, 50%);
    z-index: 3;
    width: clamp(50px, 4.4vw, 66px);
    height: clamp(50px, 4.4vw, 66px);
    border-radius: 50%;
    background: var(--gpl-red);
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.28);
  }
  .gpl-how-{{ section.id }} .gpl-how-card__badge svg {
    width: 52%;
    height: 52%;
    color: #FFFFFF;
    stroke: currentColor;
  }

  /* chevron sitting in the gap between cards */
  .gpl-how-{{ section.id }} .gpl-how-card__chev {
    position: absolute;
    top: 50%;
    right: 0;
    transform: translate(50%, -50%);
    z-index: 4;
    width: clamp(34px, 2.9vw, 44px);
    height: clamp(34px, 2.9vw, 44px);
    border-radius: 50%;
    background: #0A0A0A;
    border: 1px solid rgba(255, 255, 255, 0.16);
    color: var(--gpl-red);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .gpl-how-{{ section.id }} .gpl-how-card__chev svg {
    width: 48%;
    height: 48%;
  }

  .gpl-how-{{ section.id }} .gpl-how-card__body {
    flex: 1 1 auto;
    padding: calc(clamp(50px, 4.4vw, 66px) / 2 + 14px) clamp(12px, 1.1vw, 18px) clamp(10px, 1vw, 14px);
    text-align: center;
  }
  .gpl-how-{{ section.id }} .gpl-how-card__body:last-child { border-radius: 0 0 var(--gpl-radius) var(--gpl-radius); }
  .gpl-how-{{ section.id }} .gpl-how-card__title {
    margin: 0 0 clamp(7px, 0.8vw, 11px);
    color: var(--gpl-ink);
    font-weight: 800;
    text-transform: uppercase;
    line-height: 1.1;
    letter-spacing: -0.005em;
    font-size: clamp(14px, 1.15vw, 19px);
  }
  .gpl-how-{{ section.id }} .gpl-how-card__desc {
    margin: 0;
    color: #4A4A4A;
    font-size: clamp(11px, 0.78vw, 13px);
    line-height: 1.5;
  }

  .gpl-how-{{ section.id }} .gpl-how-card__chipwrap {
    flex: 0 0 auto;
    padding: 0 clamp(12px, 1.1vw, 18px) clamp(13px, 1.2vw, 18px);
  }
  .gpl-how-{{ section.id }} .gpl-how-card__chip {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    width: 100%;
    background: #EFEFEF;
    border-radius: 8px;
    padding: clamp(8px, 0.8vw, 12px) clamp(8px, 0.8vw, 14px);
    color: #1A1A1A;
    font-weight: 600;
    font-size: clamp(10.5px, 0.72vw, 12px);
    line-height: 1.3;
    text-align: center;
  }
  .gpl-how-{{ section.id }} .gpl-how-card__chip-icon {
    flex: 0 0 auto;
    display: flex;
    color: #1A1A1A;
  }
  .gpl-how-{{ section.id }} .gpl-how-card__chip-icon svg {
    width: clamp(14px, 1.05vw, 18px);
    height: clamp(14px, 1.05vw, 18px);
  }

  /* ---------- 3. Feature bar ---------- */
  .gpl-how-{{ section.id }} .gpl-how__features {
    box-sizing: border-box;
    width: var(--gpl-shell);
    margin: clamp(16px, 1.6vw, 24px) auto 0;
    padding: clamp(14px, 1.5vw, 22px) clamp(10px, 1.2vw, 18px);
    border: 2px solid var(--gpl-red);
    border-radius: 12px;
    background: #0F0F0F;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }
  .gpl-how-{{ section.id }} .gpl-how-feature {
    display: flex;
    align-items: center;
    gap: clamp(10px, 1vw, 16px);
    min-width: 0;
    padding: clamp(4px, 0.6vw, 8px) clamp(12px, 1.4vw, 24px);
    border-left: 1px solid rgba(255, 255, 255, 0.16);
  }
  .gpl-how-{{ section.id }} .gpl-how-feature:nth-child(4n + 1) { border-left: none; }
  .gpl-how-{{ section.id }} .gpl-how-feature__icon {
    flex: 0 0 auto;
    display: flex;
    color: #FFFFFF;
  }
  .gpl-how-{{ section.id }} .gpl-how-feature__icon svg {
    width: clamp(30px, 2.8vw, 46px);
    height: clamp(30px, 2.8vw, 46px);
  }
  .gpl-how-{{ section.id }} .gpl-how-feature__copy { min-width: 0; }
  .gpl-how-{{ section.id }} .gpl-how-feature__title {
    margin: 0 0 3px;
    color: #FFFFFF;
    font-weight: 800;
    text-transform: uppercase;
    font-size: clamp(11px, 0.85vw, 13.5px);
    line-height: 1.2;
  }
  .gpl-how-{{ section.id }} .gpl-how-feature__desc {
    margin: 0;
    color: #B4B4B4;
    font-size: clamp(10px, 0.68vw, 11.5px);
    line-height: 1.4;
  }

  /* ---------- 4. CTA ---------- */
  .gpl-how-{{ section.id }} .gpl-how__cta {
    margin-top: clamp(16px, 1.8vw, 26px);
    padding: 0 20px;
    text-align: center;
  }
  .gpl-how-{{ section.id }} .gpl-how__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: clamp(10px, 1vw, 18px);
    background: var(--gpl-red);
    color: #FFFFFF;
    text-decoration: none;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.01em;
    font-size: clamp(13px, 1.2vw, 18px);
    line-height: 1;
    padding: clamp(14px, 1.4vw, 20px) clamp(26px, 3vw, 52px);
    border-radius: 8px;
    transition: background-color 0.2s ease;
  }
  .gpl-how-{{ section.id }} .gpl-how__btn:hover { background: #B5141A; }
  .gpl-how-{{ section.id }} .gpl-how__btn:focus-visible {
    outline: 3px solid #FFFFFF;
    outline-offset: 3px;
  }
  .gpl-how-{{ section.id }} .gpl-how__btn-icon { display: flex; }
  .gpl-how-{{ section.id }} .gpl-how__btn-icon svg {
    width: clamp(24px, 2.2vw, 38px);
    height: clamp(24px, 2.2vw, 38px);
  }
  .gpl-how-{{ section.id }} .gpl-how__btn-arrow {
    width: clamp(18px, 1.5vw, 24px);
    height: clamp(18px, 1.5vw, 24px);
  }

  /* ---------- Responsive ---------- */
  @media screen and (max-width: 989px) {
    .gpl-how-{{ section.id }} .gpl-how__steps {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    /* the chevrons only read correctly in the single 4-across row */
    .gpl-how-{{ section.id }} .gpl-how-card__chev { display: none; }
    .gpl-how-{{ section.id }} .gpl-how__features {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 16px 0;
    }
    .gpl-how-{{ section.id }} .gpl-how-feature:nth-child(2n + 1) { border-left: none; }
    .gpl-how-{{ section.id }} .gpl-how-feature:nth-child(2n) { border-left: 1px solid rgba(255, 255, 255, 0.16); }
  }

  @media screen and (max-width: 749px) {
    .gpl-how-{{ section.id }} .gpl-how-card__badge { width: 48px; height: 48px; }
    .gpl-how-{{ section.id }} .gpl-how-card__body { padding-top: 38px; }
    .gpl-how-{{ section.id }} .gpl-how__btn { width: 100%; max-width: 420px; }
  }

  @media screen and (max-width: 479px) {
    .gpl-how-{{ section.id }} .gpl-how__steps {
      grid-template-columns: minmax(0, 1fr);
      gap: 14px;
    }
    .gpl-how-{{ section.id }} .gpl-how-card__frame { aspect-ratio: 16 / 9; }
    .gpl-how-{{ section.id }} .gpl-how__features {
      grid-template-columns: minmax(0, 1fr);
      gap: 14px;
    }
    .gpl-how-{{ section.id }} .gpl-how-feature { border-left: none !important; padding-left: 4px; padding-right: 4px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .gpl-how-{{ section.id }} .gpl-how__btn { transition: none; }
  }
{% endstyle %}

{% schema %}
{
  "name": "GPL How It Works",
  "tag": "section",
  "class": "gpl-section-how",
  "settings": [
    { "type": "header", "content": "Hero band" },
    { "type": "image_picker", "id": "hero_image", "label": "Background image", "info": "Optional. Sits behind the heading at 50% opacity — a dark skyline / shop-floor shot works best." },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "How It Works" },
    { "type": "text", "id": "heading_light", "label": "Heading — white part", "default": "Simple Process." },
    { "type": "text", "id": "heading_accent", "label": "Heading — red part", "default": "Premium Results." },
    { "type": "text", "id": "intro", "label": "Intro line", "default": "From your idea to your front door — we make custom printing fast, easy and hassle-free." },

    { "type": "header", "content": "Call to action" },
    { "type": "text", "id": "button_text", "label": "Button text", "default": "Start Your Order Now" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "html", "id": "button_icon", "label": "Button icon (SVG code)", "default": "<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M15.5 3.5 12 5.5 8.5 3.5 5 5.2v3.6h2.2V20h9.6V8.8H19V5.2z\"/></svg>" },

    { "type": "header", "content": "Colours" },
    { "type": "color", "id": "color_accent", "label": "Accent", "default": "#D71920" },
    { "type": "color", "id": "color_background", "label": "Section background", "default": "#0A0A0A" }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step card",
      "limit": 4,
      "settings": [
        { "type": "paragraph", "content": "Steps are numbered automatically (01, 02, 03…) in the order they appear here." },
        { "type": "image_picker", "id": "image", "label": "Card image", "info": "Optional — a placeholder shows until an image is set." },
        { "type": "html", "id": "icon", "label": "Badge icon (SVG code)", "info": "White icon on the red circle." },
        { "type": "text", "id": "title", "label": "Title", "default": "Upload Design" },
        { "type": "textarea", "id": "description", "label": "Description", "default": "Upload your logo, artwork or ideas directly on our site. We accept all file types." },
        { "type": "header", "content": "Timing chip" },
        { "type": "html", "id": "chip_icon", "label": "Chip icon (SVG code)" },
        { "type": "text", "id": "chip_text", "label": "Chip text", "default": "Takes Less Than 2 Minutes" }
      ]
    },
    {
      "type": "feature",
      "name": "Feature",
      "limit": 4,
      "settings": [
        { "type": "html", "id": "icon", "label": "Icon (SVG code)" },
        { "type": "text", "id": "title", "label": "Title", "default": "Fast Turnaround" },
        { "type": "textarea", "id": "description", "label": "Description", "default": "Same-day & next-day printing options available." }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "GPL How It Works",
      "blocks": [
        {
