{%- comment -%}
  GTA Print Lab — Brands We Print On
  File: sections/gpl-brands.liquid
{%- endcomment -%}

<section class="gpl-brands-{{ section.id }} gpl-brands">
  <div class="gpl-brands__inner">
    {%- if section.settings.heading != blank -%}
      <h2 class="gpl-brands__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}
    <div class="gpl-brands__row">
      {%- for block in section.blocks -%}
        {%- if block.type == 'brand' -%}
          <div class="gpl-brand-logo" {{ block.shopify_attributes }}>
            {%- if block.settings.logo != blank -%}
              <img
                src="{{ block.settings.logo | image_url: width: 240 }}"
                alt="{{ block.settings.name | escape }}"
                width="{{ block.settings.logo.width }}"
                height="{{ block.settings.logo.height }}"
                loading="lazy"
              >
            {%- else -%}
              <span class="gpl-brand-logo__text">{{ block.settings.name }}</span>
            {%- endif -%}
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% style %}
  .gpl-brands-{{ section.id }} { background: #1B1B1B; padding: 48px 24px; border-top: 1px solid rgba(255,255,255,0.08); border-bottom: 1px solid rgba(255,255,255,0.08); }
  .gpl-brands-{{ section.id }} .gpl-brands__inner { max-width: 1400px; margin: 0 auto; }
  .gpl-brands-{{ section.id }} .gpl-brands__heading {
    text-align: center; color: #777777; font-size: 12px; font-weight: 700; text-transform: uppercase;
    letter-spacing: 0.1em; margin: 0 0 28px;
  }
  .gpl-brands-{{ section.id }} .gpl-brands__row {
    display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: 40px;
  }
  .gpl-brands-{{ section.id }} .gpl-brand-logo { display: flex; align-items: center; justify-content: center; opacity: 0.65; filter: grayscale(100%) brightness(2); transition: opacity .2s ease; }
  .gpl-brands-{{ section.id }} .gpl-brand-logo:hover { opacity: 1; }
  .gpl-brands-{{ section.id }} .gpl-brand-logo img { max-height: 26px; width: auto; }
  .gpl-brands-{{ section.id }} .gpl-brand-logo__text { color: #CCCCCC; font-weight: 800; text-transform: uppercase; font-size: 15px; letter-spacing: 0.03em; }

  @media screen and (max-width: 549px) {
    .gpl-brands-{{ section.id }} { padding: 36px 16px; }
    .gpl-brands-{{ section.id }} .gpl-brands__row { gap: 24px 28px; }
    .gpl-brands-{{ section.id }} .gpl-brand-logo img { max-height: 20px; }
  }
{% endstyle %}

{% schema %}
{
  "name": "GPL Brands",
  "tag": "section",
  "class": "gpl-section-brands",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Brands We Print On" }
  ],
  "blocks": [
    {
      "type": "brand",
      "name": "Brand",
      "settings": [
        { "type": "image_picker", "id": "logo", "label": "Logo" },
        { "type": "text", "id": "name", "label": "Brand name", "default": "Nike" }
      ]
    }
  ],
  "max_blocks": 16,
  "presets": [
    {
      "name": "GPL Brands",
      "blocks": [
        { "type": "brand", "settings": { "name": "Nike" } },
        { "type": "brand", "settings": { "name": "Adidas" } },
        { "type": "brand", "settings": { "name": "New Era" } },
        { "type": "brand", "settings": { "name": "Gildan" } },
        { "type": "brand", "settings": { "name": "Bella + Canvas" } },
        { "type": "brand", "settings": { "name": "Jerzees" } },
        { "type": "brand", "settings": { "name": "Independent Trading" } },
        { "type": "brand", "settings": { "name": "OGIO" } },
        { "type": "brand", "settings": { "name": "The North Face" } },
        { "type": "brand", "settings": { "name": "Under Armour" } },
        { "type": "brand", "settings": { "name": "Carhartt" } },
        { "type": "brand", "settings": { "name": "Richardson" } },
        { "type": "brand", "settings": { "name": "Yupoong" } },
        { "type": "brand", "settings": { "name": "AS Colour" } }
      ]
    }
  ]
}
{% endschema %}
