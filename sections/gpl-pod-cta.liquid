{%- comment -%}
  GTA Print Lab — Print On Demand page: Closing CTA
  Left — heading, text, two buttons. Right — up to 4 icon reassurance items.
{%- endcomment -%}

{%- assign s = section.settings -%}
{%- assign buttons = section.blocks | where: 'type', 'button' -%}
{%- assign assures = section.blocks | where: 'type', 'assure' -%}

<section id="gpl-pod-cta-{{ section.id }}" class="gpl-pod-cta">
  <div class="gpl-pod-cta__inner">
    <div class="gpl-pod-cta__copy">
      {%- if s.heading != blank -%}
        <h2 class="gpl-pod-cta__heading">{{ s.heading }}</h2>
      {%- endif -%}
      {%- if s.text != blank -%}
        <p class="gpl-pod-cta__text">{{ s.text }}</p>
      {%- endif -%}
      {%- if buttons.size > 0 -%}
        <div class="gpl-pod-cta__buttons">
          {%- for block in buttons -%}
            <a
              href="{{ block.settings.link | default: '#' }}"
              class="gpl-pod-cta__btn gpl-pod-cta__btn--{{ block.settings.style }}"
              {{ block.shopify_attributes }}
            >
              <span>{{ block.settings.label }}</span>
              {%- if block.settings.style == 'primary' -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M5 12h14M13 5l7 7-7 7"/>
                </svg>
              {%- endif -%}
            </a>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    {%- if assures.size > 0 -%}
      <div class="gpl-pod-cta__assures">
        {%- for block in assures -%}
          <div class="gpl-pod-cta__assure" {{ block.shopify_attributes }}>
            {%- if block.settings.icon != blank -%}
              <span class="gpl-pod-cta__assure-icon">{{ block.settings.icon }}</span>
            {%- endif -%}
            {%- if block.settings.label != blank -%}
              <span class="gpl-pod-cta__assure-label">{{ block.settings.label }}</span>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% style %}
  #gpl-pod-cta-{{ section.id }} {
    --gpl-accent: {{ s.color_accent | default: '#D71920' }};
    background: {{ s.color_background | default: '#0A0A0A' }};
    padding: 0 0 clamp(28px, 3.2vw, 46px);
  }
  #gpl-pod-cta-{{ section.id }} .gpl-pod-cta__inner {
    box-sizing: border-box;
    width: min(1520px, calc(100% - clamp(28px, 3.2vw, 48px)));
    margin: 0 auto;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 8px;
    background: #101010;
    padding: clamp(18px, 2vw, 30px);
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    gap: clamp(16px, 2vw, 32px);
    align-items: center;
  }
  #gpl-pod-cta-{{ section.id }} .gpl-pod-cta__heading {
    margin: 0 0 8px;
    color: #FFFFFF;
    font-family: var(--gpl-font-heading, inherit);
    font-weight: 800;
    text-transform: uppercase;
    line-height: 1.05;
    letter-spacing: -0.005em;
    font-size: clamp(20px, 2.2vw, 32px);
  }
  #gpl-pod-cta-{{ section.id }} .gpl-pod-cta__text {
    margin: 0 0 clamp(12px, 1.4vw, 20px);
    color: #A8A8A8;
    font-size: clamp(11px, 0.8vw, 13.5px);
    line-height: 1.5;
    max-width: 56ch;
  }
  #gpl-pod-cta-{{ section.id }} .gpl-pod-cta__buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  #gpl-pod-cta-{{ section.id }} .gpl-pod-cta__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 9px;
    padding: 13px 26px;
    border-radius: 5px;
    border: 2px solid transparent;
    text-decoration: none;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    font-size: clamp(11px, 0.9vw, 13.5px);
    transition: background-color 0.2s ease, border-color 0.2s ease;
  }
  #gpl-pod-cta-{{ section.id }} .gpl-pod-cta__btn svg { width: 15px; height: 15px; }
  #gpl-pod-cta-{{ section.id }} .gpl-pod-cta__btn--primary { background: var(--gpl-accent); color: #FFFFFF; }
  #gpl-pod-cta-{{ section.id }} .gpl-pod-cta__btn--primary:hover { background: #B5141A; }
  #gpl-pod-cta-{{ section.id }} .gpl-pod-cta__btn--outline {
    background: transparent;
    color: #FFFFFF;
    border-color: rgba(255, 255, 255, 0.4);
  }
  #gpl-pod-cta-{{ section.id }} .gpl-pod-cta__btn--outline:hover { border-color: #FFFFFF; background: rgba(255, 255, 255, 0.08); }
  #gpl-pod-cta-{{ section.id }} .gpl-pod-cta__btn:focus-visible { outline: 3px solid #FFFFFF; outline-offset: 3px; }

  #gpl-pod-cta-{{ section.id }} .gpl-pod-cta__assures {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }
  #gpl-pod-cta-{{ section.id }} .gpl-pod-cta__assure {
    min-width: 0;
    text-align: center;
    padding: 0 clamp(6px, 0.8vw, 14px);
    border-left: 1px solid rgba(255, 255, 255, 0.16);
  }
  #gpl-pod-cta-{{ section.id }} .gpl-pod-cta__assure:first-child { border-left: none; }
  #gpl-pod-cta-{{ section.id }} .gpl-pod-cta__assure-icon {
    display: flex;
    justify-content: center;
    color: var(--gpl-accent);
    margin-bottom: 8px;
  }
  #gpl-pod-cta-{{ section.id }} .gpl-pod-cta__assure-icon svg {
    width: clamp(26px, 2.3vw, 38px);
    height: clamp(26px, 2.3vw, 38px);
  }
  #gpl-pod-cta-{{ section.id }} .gpl-pod-cta__assure-label {
    display: block;
    color: #FFFFFF;
    font-weight: 800;
    text-transform: uppercase;
    font-size: clamp(8.5px, 0.64vw, 11px);
    line-height: 1.25;
    letter-spacing: 0.02em;
  }

  @media screen and (max-width: 989px) {
    #gpl-pod-cta-{{ section.id }} .gpl-pod-cta__inner { grid-template-columns: minmax(0, 1fr); }
  }
  @media screen and (max-width: 749px) {
    #gpl-pod-cta-{{ section.id }} .gpl-pod-cta__btn { flex: 1 1 100%; }
    #gpl-pod-cta-{{ section.id }} .gpl-pod-cta__assures { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px 0; }
    #gpl-pod-cta-{{ section.id }} .gpl-pod-cta__assure:nth-child(2n + 1) { border-left: none; }
    #gpl-pod-cta-{{ section.id }} .gpl-pod-cta__assure-label { font-size: 10.5px; }
  }
  @media (prefers-reduced-motion: reduce) {
    #gpl-pod-cta-{{ section.id }} .gpl-pod-cta__btn { transition: none; }
  }
{% endstyle %}

{% schema %}
{
  "name": "POD Closing CTA",
  "tag": "section",
  "class": "gpl-section-pod-cta",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Ready to Launch Your POD Store?" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Start your print on demand business today and let us handle the printing, packing and shipping while you focus on growing your brand." },
    { "type": "color", "id": "color_accent", "label": "Accent", "default": "#D71920" },
    { "type": "color", "id": "color_background", "label": "Background", "default": "#0A0A0A" }
  ],
  "blocks": [
    {
      "type": "button",
      "name": "Button",
      "limit": 2,
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Start Your POD Store" },
        { "type": "url", "id": "link", "label": "Link" },
        { "type": "select", "id": "style", "label": "Style", "default": "primary", "options": [
          { "value": "primary", "label": "Red" },
          { "value": "outline", "label": "Outlined" }
        ] }
      ]
    },
    {
      "type": "assure",
      "name": "Reassurance item",
      "limit": 4,
      "settings": [
        { "type": "html", "id": "icon", "label": "Icon (SVG code)" },
        { "type": "text", "id": "label", "label": "Label", "default": "Risk Free" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [{ "name": "POD Closing CTA" }]
}
{% endschema %}
