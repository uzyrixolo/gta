{%- comment -%}
  GTA Print Lab — Hero slider.

  Banners are blocks: add a "Banner slide" in the theme editor and it becomes a
  slide with its own photo, headings, paragraph and buttons. The badge, the
  feature icon row and the bottom bar are section-level furniture and stay put
  across slides, so the hero never reshuffles while it rotates.

  A hero with no slide blocks still renders from the section's own settings —
  that is how this section behaved before, so an older page keeps its banner.
{%- endcomment -%}

{%- liquid
  assign s = section.settings
  assign section_id = section.id
  assign slides = section.blocks | where: 'type', 'slide'
  assign features = section.blocks | where: 'type', 'feature'
  assign bottom_blocks = section.blocks | where: 'type', 'bottom_item'
  assign slide_count = slides.size
  if slide_count == 0
    assign slide_count = 1
  endif
-%}

<section id="gpl-hero-{{ section_id }}"
  class="gpl-hero{% if slide_count > 1 %} gpl-hero--slider{% endif %}"
  aria-label="{{ s.slider_label | default: 'Hero banners' | escape }}"
  {% if slide_count > 1 %}
    aria-roledescription="carousel"
    data-gpl-hero
    data-autoplay="{{ s.autoplay_seconds }}"
  {% endif %}>

  <div class="gpl-hero__bgs">
    {%- if slides.size > 0 -%}
      {%- for block in slides -%}
        {% render 'gpl-hero-slide-bg', b: block.settings, index: forloop.index0, active: forloop.first, eager: forloop.first %}
      {%- endfor -%}
    {%- else -%}
      {% render 'gpl-hero-slide-bg', b: s, index: 0, active: true, eager: true %}
    {%- endif -%}
  </div>

  <div class="gpl-hero__inner">

    {%- if s.badge_enabled -%}
      <div class="gpl-hero__badge">
        <span class="gpl-hero__badge-icon">
          {%- if s.badge_icon != blank -%}
            {{ s.badge_icon }}
          {%- else -%}
            <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M12 3a9 9 0 1 0 9 9" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/><path d="M12 12l4.5-4.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/><circle cx="12" cy="12" r="1.4" fill="currentColor"/></svg>
          {%- endif -%}
        </span>
        {%- if s.badge_line1 != blank -%}<span class="gpl-hero__badge-line1">{{ s.badge_line1 }}</span>{%- endif -%}
        {%- if s.badge_line2 != blank -%}<span class="gpl-hero__badge-line2">{{ s.badge_line2 }}</span>{%- endif -%}
        {%- if s.badge_line3 != blank -%}
          <span class="gpl-hero__badge-line3">
            {{ s.badge_line3 }}
            <span class="gpl-hero__badge-leaf">
              {%- if s.badge_bottom_icon != blank -%}
                {{ s.badge_bottom_icon }}
              {%- else -%}
                <svg viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg"><path d="M12 2c.6 1.6 1.7 2.7 3 3.4-.4 1-.3 1.9.2 2.6 1-.4 1.9-.3 2.6.4-1 1.4-1 2.7-.2 3.7-1.2.2-2 .9-2.3 2 .9.6 1.3 1.5 1.1 2.5-1.3-.2-2.3.2-3 1.2-.6-.9-1.5-1.3-2.4-1.1V21h-2v-4.3c-.9-.2-1.8.2-2.4 1.1-.7-1-1.7-1.4-3-1.2-.2-1 .2-1.9 1.1-2.5-.3-1.1-1.1-1.8-2.3-2 .8-1 .8-2.3-.2-3.7.7-.7 1.6-.8 2.6-.4.5-.7.6-1.6.2-2.6 1.3-.7 2.4-1.8 3-3.4Z"/></svg>
              {%- endif -%}
            </span>
          </span>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="gpl-hero__stage">
      {%- if slides.size > 0 -%}
        {%- for block in slides -%}
          {% render 'gpl-hero-slide-content', b: block.settings, features: features, own_features: forloop.first, index: forloop.index0, active: forloop.first, attrs: block.shopify_attributes %}
        {%- endfor -%}
      {%- else -%}
        {% render 'gpl-hero-slide-content', b: s, features: features, own_features: true, index: 0, active: true %}
      {%- endif -%}
    </div>

    {%- if slide_count > 1 -%}
      <div class="gpl-hero__controls">
        <button type="button" class="gpl-hero__arrow gpl-hero__arrow--prev" data-gpl-hero-prev aria-label="Previous banner">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m15 5-7 7 7 7"/></svg>
        </button>
        <div class="gpl-hero__dots" role="tablist" aria-label="Choose a banner">
          {%- for i in (1..slide_count) -%}
            <button type="button" class="gpl-hero__dot{% if forloop.first %} is-active{% endif %}"
              role="tab" aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
              data-gpl-hero-dot="{{ forloop.index0 }}" aria-label="Banner {{ forloop.index }} of {{ slide_count }}"></button>
          {%- endfor -%}
        </div>
        <button type="button" class="gpl-hero__arrow gpl-hero__arrow--next" data-gpl-hero-next aria-label="Next banner">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m9 5 7 7-7 7"/></svg>
        </button>
        {%- if s.autoplay_seconds > 0 -%}
          <button type="button" class="gpl-hero__playpause" data-gpl-hero-toggle aria-label="Pause the banners">
            <svg class="gpl-hero__icon-pause" viewBox="0 0 24 24" fill="currentColor"><rect x="7" y="5" width="3.4" height="14" rx="1"/><rect x="13.6" y="5" width="3.4" height="14" rx="1"/></svg>
            <svg class="gpl-hero__icon-play" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5.2v13.6L19 12 8 5.2Z"/></svg>
          </button>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if bottom_blocks.size > 0 -%}
      <ul class="gpl-hero__bottombar">
        {%- for block in bottom_blocks -%}
          <li class="gpl-hero__bottombar-item" {{ block.shopify_attributes }}>
            <span class="gpl-hero__bottombar-icon">
              {%- if block.settings.icon != blank -%}
                {{ block.settings.icon }}
              {%- else -%}
                <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M4 16V7a1 1 0 0 1 1-1h9v10" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/><path d="M14 10h4l3 3v3h-7" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/><circle cx="7.5" cy="17.5" r="1.6" stroke="currentColor" stroke-width="1.5"/><circle cx="17.5" cy="17.5" r="1.6" stroke="currentColor" stroke-width="1.5"/></svg>
              {%- endif -%}
            </span>
            <span class="gpl-hero__bottombar-text">
              {%- if block.settings.title != blank -%}<span class="gpl-hero__bottombar-title">{{ block.settings.title }}</span>{%- endif -%}
              {%- if block.settings.description != blank -%}<span class="gpl-hero__bottombar-desc">{{ block.settings.description }}</span>{%- endif -%}
            </span>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</section>


{%- if slide_count > 1 -%}
<script>
  (function () {
    var root = document.getElementById('gpl-hero-{{ section_id }}');
    if (!root || root.dataset.gplHeroReady) return;
    root.dataset.gplHeroReady = '1';

    var slides = root.querySelectorAll('[data-gpl-hero-slide]');
    var bgs    = root.querySelectorAll('[data-gpl-hero-bg]');
    var dots   = root.querySelectorAll('[data-gpl-hero-dot]');
    var toggle = root.querySelector('[data-gpl-hero-toggle]');
    var count  = slides.length;
    if (count < 2) return;

    var calm = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    var delay = (parseFloat(root.dataset.autoplay) || 0) * 1000;
    var index = 0;
    var timer = null;
    var paused = calm || delay <= 0;

    function show(next) {
      index = (next + count) % count;
      for (var i = 0; i < count; i++) {
        var on = i === index;
        slides[i].classList.toggle('is-active', on);
        if (on) { slides[i].removeAttribute('aria-hidden'); } else { slides[i].setAttribute('aria-hidden', 'true'); }
        // a hidden slide's buttons must not be tabbable
        slides[i].querySelectorAll('a').forEach(function (a) {
          if (on) { a.removeAttribute('tabindex'); } else { a.setAttribute('tabindex', '-1'); }
        });
        if (bgs[i]) bgs[i].classList.toggle('is-active', on);
        if (dots[i]) { dots[i].classList.toggle('is-active', on); dots[i].setAttribute('aria-selected', on ? 'true' : 'false'); }
      }
    }

    function start() {
      stop();
      if (paused || delay <= 0) return;
      timer = setInterval(function () { show(index + 1); }, delay);
    }
    function stop() { if (timer) { clearInterval(timer); timer = null; } }

    function go(next) { show(next); start(); }

    var prev = root.querySelector('[data-gpl-hero-prev]');
    var next = root.querySelector('[data-gpl-hero-next]');
    if (prev) prev.addEventListener('click', function () { go(index - 1); });
    if (next) next.addEventListener('click', function () { go(index + 1); });
    dots.forEach(function (d) {
      d.addEventListener('click', function () { go(parseInt(d.dataset.gplHeroDot, 10) || 0); });
    });

    if (toggle) {
      toggle.classList.toggle('is-paused', paused);
      // reduced motion starts the hero paused, so the label has to start there too
      toggle.setAttribute('aria-label', paused ? 'Play the banners' : 'Pause the banners');
      toggle.addEventListener('click', function () {
        paused = !paused;
        toggle.classList.toggle('is-paused', paused);
        toggle.setAttribute('aria-label', paused ? 'Play the banners' : 'Pause the banners');
        if (paused) { stop(); } else { start(); }
      });
    }

    // hovering or tabbing into the hero should not pull the banner out from under you
    root.addEventListener('mouseenter', stop);
    root.addEventListener('mouseleave', function () { if (!paused) start(); });
    root.addEventListener('focusin', stop);
    root.addEventListener('focusout', function (e) {
      if (!root.contains(e.relatedTarget) && !paused) start();
    });
    document.addEventListener('visibilitychange', function () {
      if (document.hidden) { stop(); } else if (!paused) { start(); }
    });

    root.addEventListener('keydown', function (e) {
      if (e.key === 'ArrowLeft') { e.preventDefault(); go(index - 1); }
      if (e.key === 'ArrowRight') { e.preventDefault(); go(index + 1); }
    });

    var x0 = null;
    root.addEventListener('touchstart', function (e) { x0 = e.touches[0].clientX; stop(); }, { passive: true });
    root.addEventListener('touchend', function (e) {
      if (x0 === null) return;
      var dx = e.changedTouches[0].clientX - x0;
      x0 = null;
      if (Math.abs(dx) > 45) { go(dx < 0 ? index + 1 : index - 1); } else if (!paused) { start(); }
    }, { passive: true });

    // theme editor: selecting a slide block should bring that slide forward
    document.addEventListener('shopify:block:select', function (e) {
      if (!root.contains(e.target)) return;
      // only a slide block moves the slider; a feature or bottom-bar block sits
      // inside a slide but is not one, and selecting it should leave the view alone
      if (!e.target.matches('[data-gpl-hero-slide]')) return;
      var i = Array.prototype.indexOf.call(slides, e.target);
      if (i > -1) { stop(); show(i); }
    });
    document.addEventListener('shopify:block:deselect', function (e) {
      if (root.contains(e.target) && !paused) start();
    });

    show(0);
    start();
  })();
</script>
{%- endif -%}

{% style %}
  #gpl-hero-{{ section_id }} {
    --gpl-accent: {{ s.accent_color }};
    --gpl-heading-color: {{ s.heading_color }};
    --gpl-body-color: {{ s.body_color }};
    position: relative;
    isolation: isolate;
    min-height: {{ s.min_height_desktop }}px;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
    background: #111111;
  }
  #gpl-hero-{{ section_id }} .gpl-hero__bgs { position: absolute; inset: 0; z-index: 0; }
  /* visibility has to be held until the fade finishes, or the outgoing photo
     disappears the instant the class is removed and the hero goes black for
     the length of the cross-fade. Becoming active: flip it immediately.
     Becoming inactive: flip it only after the opacity has finished. */
  #gpl-hero-{{ section_id }} .gpl-hero__bg {
    position: absolute; inset: 0; opacity: 0; visibility: hidden;
    transition: opacity {{ s.fade_ms }}ms ease, visibility 0s linear {{ s.fade_ms }}ms;
  }
  #gpl-hero-{{ section_id }} .gpl-hero__bg.is-active {
    opacity: 1; visibility: visible;
    transition: opacity {{ s.fade_ms }}ms ease, visibility 0s linear 0s;
  }
  #gpl-hero-{{ section_id }} .gpl-hero__bg-img { width: 100%; height: 100%; object-fit: cover; object-position: var(--gpl-hero-pos, right); display: none; }
  #gpl-hero-{{ section_id }} .gpl-hero__bg-img--desktop { display: block; }
  /* Every stop is scaled by the slide's own overlay setting, so 0 really is no
     overlay. The multipliers keep the original shape: at the 0.9 default they
     come out as 0.9 / 0.75 / 0.25 / 0.05, exactly as before. */
  #gpl-hero-{{ section_id }} .gpl-hero__overlay {
    position: absolute; inset: 0;
    background: linear-gradient(90deg,
      rgba(11,11,11,calc(var(--gpl-hero-overlay, 0.9) * 1)) 0%,
      rgba(11,11,11,calc(var(--gpl-hero-overlay, 0.9) * 0.83)) 40%,
      rgba(11,11,11,calc(var(--gpl-hero-overlay, 0.9) * 0.28)) 72%,
      rgba(11,11,11,calc(var(--gpl-hero-overlay, 0.9) * 0.06)) 100%);
  }
  #gpl-hero-{{ section_id }} .gpl-hero__inner {
    position: relative; z-index: 1; width: 100%; max-width: 1440px; margin: 0 auto;
    padding: 64px 32px 0;
    display: flex; flex-direction: column;
  }

  /* Badge (top right) */
  #gpl-hero-{{ section_id }} .gpl-hero__badge {
    position: absolute; top: 28px; right: 32px; z-index: 2;
    width: 118px; height: 118px; border-radius: 50%;
    border: 1.5px solid rgba(255,255,255,0.7);
    background: rgba(10,10,10,0.35); backdrop-filter: blur(2px);
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    text-align: center; color: #FFFFFF; padding: 10px;
  }
  #gpl-hero-{{ section_id }} .gpl-hero__badge-icon { width: 20px; height: 20px; color: #FFFFFF; margin-bottom: 4px; }
  #gpl-hero-{{ section_id }} .gpl-hero__badge-icon svg { width: 100%; height: 100%; }
  #gpl-hero-{{ section_id }} .gpl-hero__badge-line1 { font-size: 10.5px; font-weight: 800; text-transform: uppercase; letter-spacing: .04em; line-height: 1.3; }
  #gpl-hero-{{ section_id }} .gpl-hero__badge-line2 { font-size: 10.5px; font-weight: 800; text-transform: uppercase; letter-spacing: .04em; color: var(--gpl-accent); line-height: 1.3; }
  #gpl-hero-{{ section_id }} .gpl-hero__badge-line3 { display: flex; align-items: center; gap: 4px; font-size: 8.5px; font-weight: 700; text-transform: uppercase; letter-spacing: .05em; margin-top: 4px; opacity: .9; }
  #gpl-hero-{{ section_id }} .gpl-hero__badge-leaf { width: 10px; height: 10px; color: var(--gpl-accent); display: inline-flex; }
  #gpl-hero-{{ section_id }} .gpl-hero__badge-leaf svg { width: 100%; height: 100%; }

  /* Content */
  /* Slides stack in one grid cell: the tallest sets the height, so switching
     banners never makes the page jump. */
  #gpl-hero-{{ section_id }} .gpl-hero__stage { display: grid; }
  #gpl-hero-{{ section_id }} .gpl-hero__content {
    grid-area: 1 / 1; max-width: 640px; padding-top: 24px;
    opacity: 0; visibility: hidden; pointer-events: none;
    transform: translateY(12px);
    transition: opacity {{ s.fade_ms }}ms ease, transform {{ s.fade_ms }}ms ease, visibility {{ s.fade_ms }}ms;
  }
  #gpl-hero-{{ section_id }} .gpl-hero__content.is-active {
    opacity: 1; visibility: visible; pointer-events: auto; transform: none;
  }

  /* Controls */
  #gpl-hero-{{ section_id }} .gpl-hero__controls { display: flex; align-items: center; gap: 12px; margin: 0 0 28px; }
  #gpl-hero-{{ section_id }} .gpl-hero__arrow,
  #gpl-hero-{{ section_id }} .gpl-hero__playpause {
    flex: 0 0 auto; width: 42px; height: 42px; border-radius: 50%; cursor: pointer;
    border: 1.5px solid rgba(255,255,255,0.45); background: rgba(10,10,10,0.35);
    color: #FFFFFF; display: flex; align-items: center; justify-content: center;
    transition: background-color .2s ease, border-color .2s ease;
  }
  #gpl-hero-{{ section_id }} .gpl-hero__arrow:hover,
  #gpl-hero-{{ section_id }} .gpl-hero__playpause:hover { background: var(--gpl-accent); border-color: var(--gpl-accent); }
  #gpl-hero-{{ section_id }} .gpl-hero__arrow svg { width: 20px; height: 20px; }
  #gpl-hero-{{ section_id }} .gpl-hero__playpause svg { width: 16px; height: 16px; }
  #gpl-hero-{{ section_id }} .gpl-hero__playpause .gpl-hero__icon-play { display: none; }
  #gpl-hero-{{ section_id }} .gpl-hero__playpause.is-paused .gpl-hero__icon-play { display: block; }
  #gpl-hero-{{ section_id }} .gpl-hero__playpause.is-paused .gpl-hero__icon-pause { display: none; }
  #gpl-hero-{{ section_id }} .gpl-hero__dots { display: flex; align-items: center; gap: 8px; margin: 0 4px; }
  #gpl-hero-{{ section_id }} .gpl-hero__dot {
    width: 10px; height: 10px; padding: 0; border-radius: 50%; cursor: pointer;
    border: none; background: rgba(255,255,255,0.4); transition: background-color .2s ease, width .2s ease;
  }
  #gpl-hero-{{ section_id }} .gpl-hero__dot.is-active { background: var(--gpl-accent); width: 26px; border-radius: 999px; }
  #gpl-hero-{{ section_id }} .gpl-hero__dot:hover { background: rgba(255,255,255,0.75); }
  #gpl-hero-{{ section_id }} .gpl-hero__eyebrow { color: var(--gpl-accent); font-weight: 800; letter-spacing: .08em; text-transform: uppercase; font-size: 14px; margin: 0 0 6px; }
  #gpl-hero-{{ section_id }} .gpl-hero__heading { color: var(--gpl-heading-color); font-family: var(--gpl-font-heading, inherit); font-weight: 800; line-height: .98; font-size: clamp(38px, 6vw, 72px); text-transform: uppercase; margin: 0 0 18px; letter-spacing: -0.01em; display: flex; flex-direction: column; }
  #gpl-hero-{{ section_id }} .gpl-hero__subheading { color: #FFFFFF; font-weight: 800; font-size: clamp(14px, 1.7vw, 18px); letter-spacing: .02em; text-transform: uppercase; margin: 0 0 16px; }
  #gpl-hero-{{ section_id }} .gpl-hero__subheading-highlight { color: var(--gpl-accent); }
  #gpl-hero-{{ section_id }} .gpl-hero__paragraph { color: var(--gpl-body-color); font-size: 15px; line-height: 1.6; margin: 0 0 26px; max-width: 480px; }
  #gpl-hero-{{ section_id }} .gpl-hero__paragraph p { margin: 0; }

  /* Feature icons row (stacked) */
  #gpl-hero-{{ section_id }} .gpl-hero__features { list-style: none; display: flex; flex-wrap: wrap; gap: 20px 26px; margin: 0 0 26px; padding: 0; }
  #gpl-hero-{{ section_id }} .gpl-hero__feature { display: flex; flex-direction: column; align-items: flex-start; gap: 8px; max-width: 110px; }
  #gpl-hero-{{ section_id }} .gpl-hero__feature-icon { width: 38px; height: 38px; border: 1.5px solid var(--gpl-accent); border-radius: 50%; color: var(--gpl-accent); display: flex; align-items: center; justify-content: center; padding: 8px; }
  #gpl-hero-{{ section_id }} .gpl-hero__feature-icon svg { width: 100%; height: 100%; }
  #gpl-hero-{{ section_id }} .gpl-hero__feature-label { color: #F2F2F2; font-size: 11.5px; font-weight: 800; text-transform: uppercase; letter-spacing: .02em; line-height: 1.3; }

  #gpl-hero-{{ section_id }} .gpl-hero__buttons { display: flex; flex-wrap: wrap; gap: 14px; margin-bottom: 32px; }
  #gpl-hero-{{ section_id }} .gpl-btn { display: inline-flex; align-items: center; gap: 8px; padding: 15px 28px; border-radius: 999px; font-weight: 700; font-size: 14px; letter-spacing: .02em; text-transform: uppercase; text-decoration: none; transition: background-color .2s ease, color .2s ease, transform .15s ease, border-color .2s ease; border: 2px solid transparent; }
  #gpl-hero-{{ section_id }} .gpl-btn--primary { background: var(--gpl-accent); color: #FFFFFF; }
  #gpl-hero-{{ section_id }} .gpl-btn--primary:hover { filter: brightness(0.88); transform: translateY(-1px); }
  #gpl-hero-{{ section_id }} .gpl-btn--outline { background: transparent; color: #FFFFFF; border-color: rgba(255,255,255,0.6); }
  #gpl-hero-{{ section_id }} .gpl-btn--outline:hover { border-color: #FFFFFF; background: rgba(255,255,255,0.08); }

  /* Bottom info bar */
  #gpl-hero-{{ section_id }} .gpl-hero__bottombar {
    list-style: none; display: flex; margin: 0; padding: 22px 0; border-top: 1px solid rgba(255,255,255,0.16);
  }
  #gpl-hero-{{ section_id }} .gpl-hero__bottombar-item {
    display: flex; align-items: center; gap: 12px; flex: 1; padding: 0 24px;
    border-left: 1px solid rgba(255,255,255,0.16);
  }
  #gpl-hero-{{ section_id }} .gpl-hero__bottombar-item:first-child { border-left: none; padding-left: 0; }
  #gpl-hero-{{ section_id }} .gpl-hero__bottombar-icon { flex-shrink: 0; width: 22px; height: 22px; color: var(--gpl-accent); }
  #gpl-hero-{{ section_id }} .gpl-hero__bottombar-icon svg { width: 100%; height: 100%; }
  #gpl-hero-{{ section_id }} .gpl-hero__bottombar-text { display: flex; flex-direction: column; gap: 2px; }
  #gpl-hero-{{ section_id }} .gpl-hero__bottombar-title { color: var(--gpl-accent); font-size: 12px; font-weight: 800; text-transform: uppercase; letter-spacing: .03em; }
  #gpl-hero-{{ section_id }} .gpl-hero__bottombar-desc { color: #DADADA; font-size: 12.5px; }

  @media screen and (max-width: 989px) {
    #gpl-hero-{{ section_id }} .gpl-hero__bottombar { flex-wrap: wrap; gap: 16px; }
    #gpl-hero-{{ section_id }} .gpl-hero__bottombar-item { flex: 1 1 45%; border-left: none; padding-left: 0; }
  }

  @media screen and (max-width: 749px) {
    #gpl-hero-{{ section_id }} { min-height: {{ s.min_height_mobile }}px; align-items: flex-start; }
    #gpl-hero-{{ section_id }} .gpl-hero__bg-img--desktop { display: none; }
    #gpl-hero-{{ section_id }} .gpl-hero__bg-img--mobile { display: block; }
    #gpl-hero-{{ section_id }} .gpl-hero__overlay {
      background: linear-gradient(180deg,
        rgba(11,11,11,calc(var(--gpl-hero-overlay, 0.9) * 0.56)) 0%,
        rgba(11,11,11,calc(var(--gpl-hero-overlay, 0.9) * 0.98)) 60%,
        rgba(11,11,11,calc(var(--gpl-hero-overlay, 0.9) * 1.09)) 100%);
    }
    #gpl-hero-{{ section_id }} .gpl-hero__inner { padding: 52px 18px 0; }
    #gpl-hero-{{ section_id }} .gpl-hero__badge { display: none; }
    #gpl-hero-{{ section_id }} .gpl-hero__content { max-width: 100%; padding-top: 0; }
    #gpl-hero-{{ section_id }} .gpl-hero__buttons { flex-direction: column; align-items: stretch; }
    #gpl-hero-{{ section_id }} .gpl-btn { justify-content: center; }
    #gpl-hero-{{ section_id }} .gpl-hero__features { gap: 16px 20px; }
    #gpl-hero-{{ section_id }} .gpl-hero__controls { margin-bottom: 20px; justify-content: center; }
    #gpl-hero-{{ section_id }} .gpl-hero__arrow { width: 38px; height: 38px; }
    #gpl-hero-{{ section_id }} .gpl-hero__bottombar { flex-direction: column; gap: 16px; padding: 20px 0; }
    #gpl-hero-{{ section_id }} .gpl-hero__bottombar-item { border-left: none !important; padding: 0 !important; }
  }

  @media (prefers-reduced-motion: reduce) {
    #gpl-hero-{{ section_id }} .gpl-btn { transition: none; }
    #gpl-hero-{{ section_id }} .gpl-hero__bg,
    #gpl-hero-{{ section_id }} .gpl-hero__content { transition: none; transform: none; }
  }
{% endstyle %}

