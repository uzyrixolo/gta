{%- comment -%}
  GTA Print Lab — Branding page: twin panel
  Left  — "Let's build something legendary": eyebrow, heading, text, checklist ("check" blocks), image
  Right — "From idea to icon": eyebrow, heading, 4 icon steps with arrows ("step" blocks),
          3-column mini checklist ("mini" blocks)
{%- endcomment -%}

{%- assign s = section.settings -%}
{%- assign checks = section.blocks | where: 'type', 'check' -%}
{%- assign steps = section.blocks | where: 'type', 'step' -%}
{%- assign minis = section.blocks | where: 'type', 'mini' -%}

<section id="gpl-brand-duo-{{ section.id }}" class="gpl-brand-duo">
  <div class="gpl-brand-duo__inner">
    <div class="gpl-brand-duo__panel">
      {%- if s.left_eyebrow != blank -%}
        <p class="gpl-brand-duo__eyebrow">{{ s.left_eyebrow }}</p>
      {%- endif -%}
      {%- if s.left_heading != blank -%}
        <h2 class="gpl-brand-duo__heading">{{ s.left_heading }}</h2>
      {%- endif -%}
      {%- if s.left_text != blank -%}
        <p class="gpl-brand-duo__text">{{ s.left_text }}</p>
      {%- endif -%}

      <div class="gpl-brand-duo__left-body">
        {%- if checks.size > 0 -%}
          <ul class="gpl-brand-duo__checks">
            {%- for block in checks -%}
              <li {{ block.shopify_attributes }}>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M4 12.5l5 5L20 6.5"/>
                </svg>
                <span>{{ block.settings.label }}</span>
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}

        {%- if s.left_image != blank -%}
          <div class="gpl-brand-duo__media">
            {{
              s.left_image
              | image_url: width: 900
              | image_tag:
                loading: 'lazy',
                sizes: '(max-width: 989px) 90vw, 26vw',
                widths: '350, 550, 750, 900',
                alt: s.left_image.alt | escape
            }}
          </div>
        {%- endif -%}
      </div>
    </div>

    <div class="gpl-brand-duo__panel">
      {%- if s.right_eyebrow != blank -%}
        <p class="gpl-brand-duo__eyebrow">{{ s.right_eyebrow }}</p>
      {%- endif -%}
      {%- if s.right_heading != blank -%}
        <h2 class="gpl-brand-duo__heading">{{ s.right_heading }}</h2>
      {%- endif -%}
      {%- if s.right_text != blank -%}
        <p class="gpl-brand-duo__text">{{ s.right_text }}</p>
      {%- endif -%}

      {%- if steps.size > 0 -%}
        <div class="gpl-brand-duo__steps">
          {%- for block in steps -%}
            <div class="gpl-brand-duo__step" {{ block.shopify_attributes }}>
              {%- if block.settings.icon != blank -%}
                <span class="gpl-brand-duo__step-icon">{{ block.settings.icon }}</span>
              {%- endif -%}
              {%- if block.settings.label != blank -%}
                <span class="gpl-brand-duo__step-label">{{ block.settings.label }}</span>
              {%- endif -%}
              {%- unless forloop.last -%}
                <span class="gpl-brand-duo__step-arrow" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
                </span>
              {%- endunless -%}
            </div>
          {%- endfor -%}
        </div>
      {%- endif -%}

      {%- if minis.size > 0 -%}
        <ul class="gpl-brand-duo__minis">
          {%- for block in minis -%}
            <li {{ block.shopify_attributes }}>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="12" cy="12" r="9"/><path d="M8.5 12.3l2.4 2.4 4.6-5"/>
              </svg>
              <span>{{ block.settings.label }}</span>
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
  </div>
</section>

{% style %}
  #gpl-brand-duo-{{ section.id }} {
    --gpl-accent: {{ s.color_accent | default: '#D71920' }};
    background: {{ s.color_background | default: '#0A0A0A' }};
    padding: 0 0 clamp(28px, 3.2vw, 46px);
  }
  #gpl-brand-duo-{{ section.id }} .gpl-brand-duo__inner {
    box-sizing: border-box;
    width: min(1520px, calc(100% - clamp(28px, 3.2vw, 48px)));
    margin: 0 auto;
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
    gap: clamp(12px, 1.3vw, 20px);
    align-items: stretch;
  }
  #gpl-brand-duo-{{ section.id }} .gpl-brand-duo__panel {
    box-sizing: border-box;
    border: 1px solid rgba(215, 25, 32, 0.6);
    border-radius: 8px;
    background: #100C0C;
    padding: clamp(16px, 1.8vw, 26px);
    min-width: 0;
  }
  #gpl-brand-duo-{{ section.id }} .gpl-brand-duo__eyebrow {
    margin: 0 0 5px;
    color: var(--gpl-accent);
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    font-size: clamp(10.5px, 0.8vw, 13px);
  }
  #gpl-brand-duo-{{ section.id }} .gpl-brand-duo__heading {
    margin: 0 0 10px;
    color: #FFFFFF;
    font-family: var(--gpl-font-heading, inherit);
    font-weight: 800;
    text-transform: uppercase;
    line-height: 1.08;
    letter-spacing: -0.005em;
    font-size: clamp(17px, 1.65vw, 25px);
  }
  #gpl-brand-duo-{{ section.id }} .gpl-brand-duo__text {
    margin: 0 0 clamp(12px, 1.3vw, 18px);
    color: #A8A8A8;
    font-size: clamp(10.5px, 0.76vw, 13px);
    line-height: 1.5;
    max-width: 60ch;
  }
  #gpl-brand-duo-{{ section.id }} .gpl-brand-duo__left-body {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 0.85fr);
    gap: clamp(12px, 1.4vw, 22px);
    align-items: center;
  }
  {%- if s.left_image == blank -%}
    #gpl-brand-duo-{{ section.id }} .gpl-brand-duo__left-body { grid-template-columns: minmax(0, 1fr); }
  {%- endif -%}
  #gpl-brand-duo-{{ section.id }} .gpl-brand-duo__checks {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: clamp(7px, 0.7vw, 10px);
  }
  #gpl-brand-duo-{{ section.id }} .gpl-brand-duo__checks li {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    color: #E4E4E4;
    font-size: clamp(10.5px, 0.78vw, 13.5px);
    line-height: 1.4;
  }
  #gpl-brand-duo-{{ section.id }} .gpl-brand-duo__checks svg {
    flex: 0 0 auto;
    width: clamp(12px, 0.9vw, 15px);
    height: clamp(12px, 0.9vw, 15px);
    margin-top: 2px;
    color: var(--gpl-accent);
  }
  #gpl-brand-duo-{{ section.id }} .gpl-brand-duo__media {
    border-radius: 6px;
    overflow: hidden;
    background: #1E1E1E;
    align-self: stretch;
    min-height: 200px;
    position: relative;
  }
  #gpl-brand-duo-{{ section.id }} .gpl-brand-duo__media img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  #gpl-brand-duo-{{ section.id }} .gpl-brand-duo__steps {
    display: grid;
    grid-template-columns: repeat({{ steps.size | at_least: 1 }}, minmax(0, 1fr));
    gap: clamp(8px, 1vw, 16px);
    margin: clamp(10px, 1.1vw, 16px) 0 clamp(14px, 1.5vw, 22px);
  }
  #gpl-brand-duo-{{ section.id }} .gpl-brand-duo__step {
    position: relative;
    min-width: 0;
    text-align: center;
  }
  #gpl-brand-duo-{{ section.id }} .gpl-brand-duo__step-icon {
    display: flex;
    justify-content: center;
    margin-bottom: 8px;
  }
  #gpl-brand-duo-{{ section.id }} .gpl-brand-duo__step-icon svg {
    width: clamp(34px, 3vw, 50px);
    height: clamp(34px, 3vw, 50px);
    color: var(--gpl-accent);
  }
  #gpl-brand-duo-{{ section.id }} .gpl-brand-duo__step-label {
    display: block;
    color: #FFFFFF;
    font-weight: 800;
    text-transform: uppercase;
    font-size: clamp(9px, 0.68vw, 11.5px);
    line-height: 1.25;
  }
  #gpl-brand-duo-{{ section.id }} .gpl-brand-duo__step-arrow {
    position: absolute;
    top: clamp(17px, 1.5vw, 25px);
    right: calc(-1 * clamp(4px, 0.5vw, 8px) - 7px);
    transform: translateY(-50%);
    color: var(--gpl-accent);
    display: flex;
  }
  #gpl-brand-duo-{{ section.id }} .gpl-brand-duo__step-arrow svg { width: 14px; height: 14px; }

  #gpl-brand-duo-{{ section.id }} .gpl-brand-duo__minis {
    list-style: none;
    margin: 0;
    padding: clamp(12px, 1.3vw, 18px) 0 0;
    border-top: 1px solid rgba(255, 255, 255, 0.14);
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(7px, 0.7vw, 11px) clamp(10px, 1.1vw, 18px);
  }
  #gpl-brand-duo-{{ section.id }} .gpl-brand-duo__minis li {
    display: flex;
    align-items: flex-start;
    gap: 7px;
    min-width: 0;
    color: #E4E4E4;
    font-weight: 600;
    font-size: clamp(9.5px, 0.72vw, 12.5px);
    line-height: 1.35;
  }
  #gpl-brand-duo-{{ section.id }} .gpl-brand-duo__minis svg {
    flex: 0 0 auto;
    width: clamp(12px, 0.88vw, 15px);
    height: clamp(12px, 0.88vw, 15px);
    margin-top: 1px;
    color: var(--gpl-accent);
  }

  @media screen and (max-width: 1199px) {
    #gpl-brand-duo-{{ section.id }} .gpl-brand-duo__inner { grid-template-columns: minmax(0, 1fr); }
  }
  @media screen and (max-width: 749px) {
    #gpl-brand-duo-{{ section.id }} .gpl-brand-duo__left-body { grid-template-columns: minmax(0, 1fr); }
    #gpl-brand-duo-{{ section.id }} .gpl-brand-duo__steps { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px 10px; }
    #gpl-brand-duo-{{ section.id }} .gpl-brand-duo__step-arrow { display: none; }
    #gpl-brand-duo-{{ section.id }} .gpl-brand-duo__step-label { font-size: 11px; }
    #gpl-brand-duo-{{ section.id }} .gpl-brand-duo__minis { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    #gpl-brand-duo-{{ section.id }} .gpl-brand-duo__minis li,
    #gpl-brand-duo-{{ section.id }} .gpl-brand-duo__checks li { font-size: 12.5px; }
  }
{% endstyle %}

{% schema %}
{
  "name": "Brand Duo panel",
  "tag": "section",
  "class": "gpl-section-brand-duo",
  "settings": [
    { "type": "header", "content": "Left panel" },
    { "type": "text", "id": "left_eyebrow", "label": "Eyebrow", "default": "Your Brand. Our Expertise." },
    { "type": "text", "id": "left_heading", "label": "Heading", "default": "Let's Build Something Legendary." },
    { "type": "textarea", "id": "left_text", "label": "Text", "default": "Whether you're starting a clothing line, launching merch for your business, or building a personal brand, GTA Print Lab has everything you need to bring your vision to life." },
    { "type": "image_picker", "id": "left_image", "label": "Image", "info": "Optional." },

    { "type": "header", "content": "Right panel" },
    { "type": "text", "id": "right_eyebrow", "label": "Eyebrow", "default": "All-In-One Branding Solution" },
    { "type": "text", "id": "right_heading", "label": "Heading", "default": "From Idea to Icon." },
    { "type": "textarea", "id": "right_text", "label": "Text", "info": "Optional." },

    { "type": "header", "content": "Colours" },
    { "type": "color", "id": "color_accent", "label": "Accent", "default": "#D71920" },
    { "type": "color", "id": "color_background", "label": "Background", "default": "#0A0A0A" }
  ],
  "blocks": [
    {
      "type": "check",
      "name": "Left checklist item",
      "limit": 8,
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Complete Brand Development" }
      ]
    },
    {
      "type": "step",
      "name": "Right step",
      "limit": 4,
      "settings": [
        { "type": "html", "id": "icon", "label": "Icon (SVG code)" },
        { "type": "text", "id": "label", "label": "Label", "default": "Strategy & Planning" }
      ]
    },
    {
      "type": "mini",
      "name": "Right mini check",
      "limit": 9,
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "One Team" }
      ]
    }
  ],
  "max_blocks": 21,
  "presets": [{ "name": "Brand Duo panel" }]
}
{% endschema %}
