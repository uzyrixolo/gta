{%- comment -%}
  GTA Print Lab — Graphic Design page: Design process (M3)
  Five auto-numbered cards on a connector rail.
{%- endcomment -%}

{%- assign s = section.settings -%}

<section id="gpl-gd-proc-{{ section.id }}" class="gpl-gd-proc">
  <div class="gpl-gd-proc__inner">
    {%- if s.heading != blank -%}
      <h2 class="gpl-gd-proc__heading">{{ s.heading }}</h2>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="gpl-gd-proc__grid">
        <span class="gpl-gd-proc__rail" aria-hidden="true"></span>
        {%- for block in section.blocks -%}
          <article class="gpl-gd-proc-card" {{ block.shopify_attributes }}>
            <span class="gpl-gd-proc-card__num" aria-hidden="true">
              {%- if forloop.index < 10 -%}0{%- endif -%}{{ forloop.index }}
            </span>
            <div class="gpl-gd-proc-card__top">
              {%- if block.settings.icon != blank -%}
                <span class="gpl-gd-proc-card__icon">{{ block.settings.icon }}</span>
              {%- endif -%}
              {%- if block.settings.title != blank -%}
                <h3 class="gpl-gd-proc-card__title">{{ block.settings.title }}</h3>
              {%- endif -%}
            </div>
            {%- if block.settings.description != blank -%}
              <p class="gpl-gd-proc-card__desc">{{ block.settings.description }}</p>
            {%- endif -%}
          </article>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% style %}
  #gpl-gd-proc-{{ section.id }} {
    --gpl-accent: {{ s.color_accent | default: '#D71920' }};
    background: {{ s.color_background | default: '#0A0A0A' }};
    padding: clamp(24px, 2.8vw, 40px) 0 clamp(30px, 3.4vw, 50px);
  }
  #gpl-gd-proc-{{ section.id }} .gpl-gd-proc__inner {
    box-sizing: border-box;
    width: min(1520px, calc(100% - clamp(28px, 3.2vw, 48px)));
    margin: 0 auto;
  }
  #gpl-gd-proc-{{ section.id }} .gpl-gd-proc__heading {
    margin: 0 0 clamp(20px, 2.2vw, 32px);
    text-align: center;
    color: #FFFFFF;
    font-family: var(--gpl-font-heading, inherit);
    font-weight: 800;
    text-transform: uppercase;
    line-height: 1.05;
    letter-spacing: -0.005em;
    font-size: clamp(22px, 2.6vw, 38px);
  }
  #gpl-gd-proc-{{ section.id }} .gpl-gd-proc__grid {
    position: relative;
    display: grid;
    grid-template-columns: repeat({{ section.blocks.size | at_least: 1 }}, minmax(0, 1fr));
    gap: clamp(12px, 1.3vw, 20px);
    align-items: stretch;
  }
  #gpl-gd-proc-{{ section.id }} .gpl-gd-proc__rail {
    position: absolute;
    top: 50%;
    left: 8%;
    right: 8%;
    height: 2px;
    background: repeating-linear-gradient(90deg, rgba(215,25,32,0.85) 0 10px, transparent 10px 20px);
    z-index: 0;
  }
  #gpl-gd-proc-{{ section.id }} .gpl-gd-proc-card {
    position: relative;
    z-index: 1;
    box-sizing: border-box;
    background: #141414;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 6px;
    padding: clamp(14px, 1.3vw, 20px) clamp(12px, 1.1vw, 17px) clamp(13px, 1.2vw, 18px);
    min-width: 0;
  }
  #gpl-gd-proc-{{ section.id }} .gpl-gd-proc-card__num {
    position: absolute;
    top: 0;
    left: clamp(12px, 1.1vw, 17px);
    transform: translateY(-50%);
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: center;
    width: clamp(26px, 2.1vw, 34px);
    height: clamp(26px, 2.1vw, 34px);
    border-radius: 50%;
    background: var(--gpl-accent);
    color: #FFFFFF;
    font-weight: 800;
    font-size: clamp(11px, 0.85vw, 14px);
    line-height: 1;
  }
  #gpl-gd-proc-{{ section.id }} .gpl-gd-proc-card__top {
    display: flex;
    align-items: center;
    gap: 9px;
    margin: clamp(8px, 0.8vw, 12px) 0 9px;
  }
  #gpl-gd-proc-{{ section.id }} .gpl-gd-proc-card__icon { flex: 0 0 auto; display: flex; color: #FFFFFF; }
  #gpl-gd-proc-{{ section.id }} .gpl-gd-proc-card__icon svg {
    width: clamp(20px, 1.6vw, 26px);
    height: clamp(20px, 1.6vw, 26px);
  }
  #gpl-gd-proc-{{ section.id }} .gpl-gd-proc-card__title {
    margin: 0;
    min-width: 0;
    color: #FFFFFF;
    font-weight: 800;
    text-transform: uppercase;
    font-size: clamp(10.5px, 0.78vw, 13px);
    line-height: 1.2;
    letter-spacing: 0.01em;
  }
  #gpl-gd-proc-{{ section.id }} .gpl-gd-proc-card__desc {
    margin: 0;
    color: #9C9C9C;
    font-size: clamp(10px, 0.7vw, 11.5px);
    line-height: 1.45;
  }

  @media screen and (max-width: 1199px) {
    #gpl-gd-proc-{{ section.id }} .gpl-gd-proc__grid { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px 14px; }
    #gpl-gd-proc-{{ section.id }} .gpl-gd-proc__rail { display: none; }
    #gpl-gd-proc-{{ section.id }} .gpl-gd-proc-card__title { font-size: 13px; }
    #gpl-gd-proc-{{ section.id }} .gpl-gd-proc-card__desc { font-size: 11.5px; }
  }
  @media screen and (max-width: 749px) {
    #gpl-gd-proc-{{ section.id }} .gpl-gd-proc__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media screen and (max-width: 419px) {
    #gpl-gd-proc-{{ section.id }} .gpl-gd-proc__grid { grid-template-columns: minmax(0, 1fr); }
  }
{% endstyle %}

{% schema %}
{
  "name": "GD Process",
  "tag": "section",
  "class": "gpl-section-gd-proc",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Our Design Process" },
    { "type": "color", "id": "color_accent", "label": "Accent", "default": "#D71920" },
    { "type": "color", "id": "color_background", "label": "Background", "default": "#0A0A0A" }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "limit": 6,
      "settings": [
        { "type": "paragraph", "content": "Steps are numbered automatically (01, 02, 03…) in the order they appear here." },
        { "type": "html", "id": "icon", "label": "Icon (SVG code)" },
        { "type": "text", "id": "title", "label": "Title", "default": "Tell Us Your Idea" },
        { "type": "textarea", "id": "description", "label": "Description", "default": "Upload your artwork, sketch, photo or explain your idea. Don't have artwork? That's okay!" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [{ "name": "GD Process" }]
}
{% endschema %}
