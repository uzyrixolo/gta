{%- comment -%}
  GTA Print Lab — About page: "Our Story" — founder narrative + pull-quote.
  Photo is optional (image_picker) rather than hard-coded, since no real
  photo of the founder was supplied — falls back to a plain quote card.
{%- endcomment -%}

{%- assign s = section.settings -%}

<section id="gpl-ab-story-{{ section.id }}" class="gpl-ab-story">
  <div class="gpl-ab-story__inner">
    {%- if s.photo != blank -%}
      <div class="gpl-ab-story__photo">
        {{ s.photo | image_url: width: 700 | image_tag: loading: 'lazy', sizes: '(max-width: 749px) 100vw, 340px', widths: '340, 500, 700', alt: s.photo_name | default: s.photo.alt | escape }}
        {%- if s.photo_name != blank or s.photo_role != blank -%}
          <div class="gpl-ab-story__nameplate">
            {%- if s.photo_name != blank -%}<p class="gpl-ab-story__nameplate-name">{{ s.photo_name }}</p>{%- endif -%}
            {%- if s.photo_role != blank -%}<p class="gpl-ab-story__nameplate-role">{{ s.photo_role }}</p>{%- endif -%}
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="gpl-ab-story__content">
      {%- if s.eyebrow != blank -%}<p class="gpl-ab-story__eyebrow">{{ s.eyebrow }}</p>{%- endif -%}
      {%- if s.heading != blank or s.heading_accent != blank -%}
        <h2 class="gpl-ab-story__heading">
          {{ s.heading }}{% if s.heading_accent != blank %} <span class="gpl-ab-story__heading-accent">{{ s.heading_accent }}</span>{% endif %}
        </h2>
      {%- endif -%}
      {%- if s.subheading != blank -%}<p class="gpl-ab-story__subheading">{{ s.subheading }}</p>{%- endif -%}
      {%- if s.paragraph != blank -%}<div class="gpl-ab-story__paragraph">{{ s.paragraph }}</div>{%- endif -%}
      {%- if s.quote != blank -%}
        <blockquote class="gpl-ab-story__quote">
          <p>{{ s.quote }}</p>
          {%- if s.quote_attribution != blank -%}<cite>{{ s.quote_attribution }}</cite>{%- endif -%}
        </blockquote>
      {%- endif -%}
    </div>
  </div>
</section>

{% style %}
  #gpl-ab-story-{{ section.id }} {
    --gpl-accent: {{ s.color_accent | default: '#D71920' }};
    background: {{ s.color_background | default: '#0E0E0E' }};
    padding: clamp(48px, 5.5vw, 88px) 0;
  }
  #gpl-ab-story-{{ section.id }} .gpl-ab-story__inner {
    box-sizing: border-box;
    width: min(1200px, calc(100% - clamp(28px, 3.2vw, 48px)));
    margin: 0 auto;
    display: grid;
    grid-template-columns: {% if s.photo != blank %}340px 1fr{% else %}1fr{% endif %};
    gap: clamp(28px, 3.5vw, 56px);
    align-items: center;
  }
  /* No fixed ratio: the photo keeps its own proportions, so portrait or
     landscape uploads both show in full instead of being cropped. */
  #gpl-ab-story-{{ section.id }} .gpl-ab-story__photo img {
    width: 100%; height: auto; border-radius: 12px; display: block;
  }
  #gpl-ab-story-{{ section.id }} .gpl-ab-story__photo { position: relative; }
  #gpl-ab-story-{{ section.id }} .gpl-ab-story__nameplate {
    position: absolute; left: 0; bottom: 18px; padding: 9px 16px 9px 12px;
    background: rgba(10, 10, 10, 0.85); border-left: 4px solid var(--gpl-accent);
    border-radius: 0 6px 6px 0;
  }
  #gpl-ab-story-{{ section.id }} .gpl-ab-story__nameplate-name {
    margin: 0; color: #FFFFFF; font-size: 13px; font-weight: 800; text-transform: uppercase; letter-spacing: 0.04em;
  }
  #gpl-ab-story-{{ section.id }} .gpl-ab-story__nameplate-role {
    margin: 2px 0 0; color: var(--gpl-accent); font-size: 10.5px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em;
  }
  #gpl-ab-story-{{ section.id }} .gpl-ab-story__eyebrow {
    color: var(--gpl-accent); font-weight: 800; letter-spacing: 0.08em; text-transform: uppercase; font-size: 12.5px; margin: 0 0 8px;
  }
  #gpl-ab-story-{{ section.id }} .gpl-ab-story__heading {
    color: #FFFFFF; font-weight: 800; text-transform: uppercase; line-height: 1.05;
    font-size: clamp(26px, 3vw, 40px); margin: 0 0 6px; letter-spacing: 0.01em;
  }
  #gpl-ab-story-{{ section.id }} .gpl-ab-story__heading-accent { color: var(--gpl-accent); }
  #gpl-ab-story-{{ section.id }} .gpl-ab-story__subheading {
    margin: 0 0 16px; color: #FFFFFF; font-weight: 700; text-transform: uppercase;
    font-size: clamp(11.5px, 0.95vw, 13.5px); letter-spacing: 0.05em;
  }
  #gpl-ab-story-{{ section.id }} .gpl-ab-story__paragraph {
    color: #C9C9C9; font-size: clamp(13.5px, 1vw, 15px); line-height: 1.7; margin: 0 0 22px; max-width: 62ch;
  }
  #gpl-ab-story-{{ section.id }} .gpl-ab-story__paragraph p { margin: 0 0 14px; }
  #gpl-ab-story-{{ section.id }} .gpl-ab-story__paragraph p:last-child { margin-bottom: 0; }
  #gpl-ab-story-{{ section.id }} .gpl-ab-story__quote {
    margin: 0; padding: 18px 22px; border-left: 3px solid var(--gpl-accent);
    background: rgba(255,255,255,0.04); border-radius: 0 8px 8px 0; max-width: 62ch;
  }
  #gpl-ab-story-{{ section.id }} .gpl-ab-story__quote p {
    margin: 0 0 8px; color: #FFFFFF; font-size: clamp(14px, 1.1vw, 16px); font-style: italic; line-height: 1.5;
  }
  #gpl-ab-story-{{ section.id }} .gpl-ab-story__quote cite {
    color: rgba(255,255,255,0.55); font-size: 12.5px; font-style: normal; font-weight: 700;
  }

  @media screen and (max-width: 749px) {
    #gpl-ab-story-{{ section.id }} .gpl-ab-story__inner { grid-template-columns: 1fr; }
    #gpl-ab-story-{{ section.id }} .gpl-ab-story__photo img { aspect-ratio: 3 / 2; max-width: 320px; margin: 0 auto; }
  }
{% endstyle %}

{% schema %}
{
  "name": "About: Story",
  "tag": "section",
  "class": "gpl-section-ab-story",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading — white part", "default": "Our" },
    { "type": "text", "id": "heading_accent", "label": "Heading — red part", "default": "Story" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "From Vision to a Global Apparel Powerhouse" },
    { "type": "richtext", "id": "paragraph", "label": "Paragraph" },
    { "type": "textarea", "id": "quote", "label": "Pull-quote" },
    { "type": "text", "id": "quote_attribution", "label": "Quote attribution" },
    { "type": "header", "content": "Photo (optional)" },
    { "type": "image_picker", "id": "photo", "label": "Photo" },
    { "type": "text", "id": "photo_name", "label": "Name plate — name", "info": "Shown over the bottom of the photo." },
    { "type": "text", "id": "photo_role", "label": "Name plate — role" },
    { "type": "header", "content": "Colours" },
    { "type": "color", "id": "color_accent", "label": "Accent", "default": "#D71920" },
    { "type": "color", "id": "color_background", "label": "Background", "default": "#0E0E0E" }
  ],
  "presets": [{ "name": "About: Story" }]
}
{% endschema %}
