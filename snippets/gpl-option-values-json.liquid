{%- comment -%}
  GTA Print Lab — option values as JSON, with Shopify's own availability.

  Liquid stops at 250 variants, so for products above that (e.g. a tee in
  73 colours x 8 sizes) the embedded variant list cannot say which colours
  exist. product_option_value.available can: Shopify computes it server
  side for every value, given the current selection. The variant picker
  reads this on load and again after each Section Rendering lookup.
{%- endcomment -%}
[{%- for option in product.options_with_values -%}
{"name":{{ option.name | json }},"position":{{ option.position }},"values":[
{%- for value in option.values -%}
{"id":{{ value.id | json }},"name":{{ value.name | json }},"available":{% if value.available %}true{% else %}false{% endif %},"selected":{% if value.selected %}true{% else %}false{% endif %}}{%- unless forloop.last -%},{%- endunless -%}
{%- endfor -%}]}{%- unless forloop.last -%},{%- endunless -%}
{%- endfor -%}]
