{%- comment -%}
  One hero slide's text column.

  b         — settings object: a slide block's settings, or the section's own
              settings when the hero has no slide blocks yet
  features  — the section's feature blocks; the icon row is shop-wide furniture,
              so every slide carries it and the row never jumps between slides
  index     — zero-based slide number
  active    — true for the slide shown first
  attrs     — block.shopify_attributes, so the theme editor can select the slide
{%- endcomment -%}
<div class="gpl-hero__content{% if active %} is-active{% endif %}"
  data-gpl-hero-slide="{{ index }}"
  {% unless active %}aria-hidden="true"{% endunless %}
  {{ attrs }}>

  {%- if b.eyebrow != blank -%}
    <p class="gpl-hero__eyebrow">{{ b.eyebrow }}</p>
  {%- endif -%}

  {%- comment -%} only the first slide is the page's h1; the rest are h2 {%- endcomment -%}
  {%- if index == 0 -%}{%- assign htag = 'h1' -%}{%- else -%}{%- assign htag = 'h2' -%}{%- endif -%}
  <{{ htag }} class="gpl-hero__heading">
    {%- if b.heading_line1 != blank -%}<span class="gpl-hero__heading-line">{{ b.heading_line1 }}</span>{%- endif -%}
    {%- if b.heading_line2 != blank -%}<span class="gpl-hero__heading-line">{{ b.heading_line2 }}</span>{%- endif -%}
  </{{ htag }}>

  {%- if b.subheading_normal != blank or b.subheading_highlight != blank -%}
    <p class="gpl-hero__subheading">
      {%- if b.subheading_normal != blank -%}{{ b.subheading_normal }}{%- endif -%}
      {%- if b.subheading_highlight != blank -%} <span class="gpl-hero__subheading-highlight">{{ b.subheading_highlight }}</span>{%- endif -%}
    </p>
  {%- endif -%}

  {%- if b.paragraph != blank -%}
    <div class="gpl-hero__paragraph">{{ b.paragraph }}</div>
  {%- endif -%}

  {%- if features != blank and features.size > 0 -%}
    <ul class="gpl-hero__features">
      {%- for block in features -%}
        <li class="gpl-hero__feature" {{ block.shopify_attributes }}>
          <span class="gpl-hero__feature-icon">
            {%- if block.settings.icon != blank -%}
              {{ block.settings.icon }}
            {%- else -%}
              <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M13 2 4 14h7l-1 8 10-13h-7l0-7Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/></svg>
            {%- endif -%}
          </span>
          <span class="gpl-hero__feature-label">{{ block.settings.label }}</span>
        </li>
      {%- endfor -%}
    </ul>
  {%- endif -%}

  <div class="gpl-hero__buttons">
    {%- if b.button1_text != blank -%}
      <a href="{{ b.button1_link | default: '#' }}" class="gpl-btn gpl-btn--primary"{% unless active %} tabindex="-1"{% endunless %}>
        {{ b.button1_text }}
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
      </a>
    {%- endif -%}
    {%- if b.button2_text != blank -%}
      <a href="{{ b.button2_link | default: '#' }}" class="gpl-btn gpl-btn--outline"{% unless active %} tabindex="-1"{% endunless %}>
        {{ b.button2_text }}
      </a>
    {%- endif -%}
  </div>
</div>
