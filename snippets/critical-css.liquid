<style>
html {
  font-size: calc(var(--font-base-size, 16) * 1px);
  -webkit-font-smoothing: antialiased;
  height: 100%;
  scroll-behavior: smooth;
}
body {
  margin: 0;
  font-family: var(--font-stack-body);
  font-weight: var(--font-weight-body);
  font-style: var(--font-style-body);
  color: var(--color-body-text);
  font-size: calc(var(--font-base-size, 16) * 1px);
  line-height: calc(var(--base-line-height) * 1px);
  background-color: {{ settings.color_main_bg }};
  position: relative;
  min-height: 100%;
}

body, html {
  /* overflow-x: clip (not hidden) — hidden forces overflow-y to auto per the CSS
     spec's legacy visible->auto coupling rule, which silently makes body its own
     scroll container and breaks position:sticky everywhere on the site (the sticky
     element sticks relative to body, which never itself scrolls, since the page
     actually scrolls via html). clip is exempt from that coupling and gives the
     same no-horizontal-scrollbar result. */
  overflow-x: clip;
}

html.prevent-scroll,
html.prevent-scroll body {
  height: auto;
  overflow: hidden;
}

/* Cart drawer: force a white panel regardless of the site's dark theme, and sit
   above the sticky header (z-index 999) and its mobile menu (z-index 1000/1001) —
   the drawer's own z-index of 100 previously let the header render on top of it. */
.m-cart-drawer {
  /* !important: assets/cart.css sets the same z-index:100 with equal selector
     specificity and loads after this critical CSS, so it would otherwise win
     the cascade purely on load order. */
  z-index: 1002 !important;
  --color-main-background: #FFFFFF;
  --color-body-text: #111111;
  --color-heading-text: #111111;
  --color-sub-text: rgba(17, 17, 17, 0.65);
}

/* Collection, cart, and the generic content pages (About/FAQ/Contact/Quote):
   white background, same treatment as the cart drawer and the product
   customizer, instead of the site's dark theme (settings.color_main_bg is
   #111111 globally — these opt out of it specifically). The content pages use
   page-faqs.liquid / contact-form.liquid etc., unstyled base-theme sections
   with no colour settings of their own, so without this they render
   near-black-on-black. */
body.template-collection,
body.template-cart,
body.faq,
body.about,
body.contact,
body.quote {
  background-color: #FFFFFF;
  --color-main-background: #FFFFFF;
  --color-body-text: #111111;
  --color-heading-text: #111111;
  --color-sub-text: rgba(17, 17, 17, 0.65);
}

h1,
h2,
h3,
h4,
h5, 
h6 {
  font-family: var(--font-stack-header);
  font-weight: var(--font-weight-header);
  font-style: var(--font-style-header);
  color: var(--color-heading-text);
  line-height: normal;
}
h1, .h1 {
  font-size:calc(((var(--font-h1-mobile))/ (var(--font-base-size))) * 1rem);
  line-height: 1.278;
}

h2, .h2 {
  font-size:calc(((var(--font-h2-mobile))/ (var(--font-base-size))) * 1rem);
  line-height: 1.267;
}

h3, .h3 {
  font-size: calc(((var(--font-h3-mobile)) / (var(--font-base-size))) * 1rem);
  line-height: 1.36;
}

h4, .h4 {
  font-size: calc(((var(--font-h4-mobile)) / (var(--font-base-size))) * 1rem);
  line-height: 1.4;
}

h5, .h5 {
  font-size: calc(((var(--font-h5-mobile)) / (var(--font-base-size))) * 1rem);
  line-height: 1.5;
}

h6, .h6 {
  font-size: calc(((var(--font-h6-mobile)) / (var(--font-base-size))) * 1rem);
  line-height: 1.5;
}

@media only screen and (min-width: 768px) {
  .h1, h1{
    font-size:calc(((var(--font-h1-tablet))/ (var(--font-base-size))) * 1rem);
    line-height: 1.238;
  }
  .h2, h2{
    font-size:calc(((var(--font-h2-tablet))/ (var(--font-base-size))) * 1rem);
    line-height: 1.235;
  }
  h3, .h3 {
    font-size: calc(((var(--font-h3-tablet)) / (var(--font-base-size))) * 1rem);
    line-height: 1.36;
  }
  h4, .h4 {
    font-size: calc(((var(--font-h4-tablet)) / (var(--font-base-size))) * 1rem);
    line-height: 1.4;
  }
}

@media only screen and (min-width: 1280px){
  .h1, h1{
    font-size:calc(((var(--font-h1-desktop))/ (var(--font-base-size))) * 1rem);
    line-height: 1.167;
  }
  .h2, h2{
    font-size:calc(((var(--font-h2-desktop))/ (var(--font-base-size))) * 1rem);
    line-height: 1.238;
  }
  h3, .h3 {
    font-size: calc(((var(--font-h3-desktop)) / (var(--font-base-size))) * 1rem);
    line-height: 1.278;
  }
  h4, .h4 {
    font-size: calc(((var(--font-h4-desktop)) / (var(--font-base-size))) * 1rem);
    line-height: 1.333;
  }
  h5, .h5 {
    font-size: calc(((var(--font-h5-desktop)) / (var(--font-base-size))) * 1rem);
  }
  h6, .h6 {
    font-size: calc(((var(--font-h6-desktop)) / (var(--font-base-size))) * 1rem);
  }
}
[style*="--aspect-ratio"] {
  position: relative;
  overflow: hidden;
}
[style*="--aspect-ratio"]:before {
  display: block;
  width: 100%;
  content: "";
  height: 0px;
}
[style*="--aspect-ratio"] > *:first-child {
  top: 0;
  left: 0;
  right: 0;
  position: absolute !important;
  object-fit: cover;
  width: 100%;
  height: 100%;
}
[style*="--aspect-ratio"]:before {
  padding-top: calc(100% / (0.0001 + var(--aspect-ratio, 16/9)));
}
@media ( max-width: 767px ) {
  [style*="--aspect-ratio"]:before {
    padding-top: calc(100% / (0.0001 + var(--aspect-ratio-mobile, var(--aspect-ratio, 16/9)) ));
  }
}
.swiper-wrapper {
  display: flex;
}
.swiper-container:not(.swiper-container-initialized) .swiper-slide {
  width: calc(100% / var(--items, 1));
  flex: 0 0 auto;
}
@media(max-width: 1023px) {
  .swiper-container:not(.swiper-container-initialized) .swiper-slide {
    min-width: 40vw;
    flex: 0 0 auto;
  }
}
@media (max-width: 767px) {
  .swiper-container:not(.swiper-container-initialized) .swiper-slide {
    min-width: 66vw;
    flex: 0 0 auto;
  }
}

/* Pricing-tier product badges (top-left, rendered by snippets/product-card-*.liquid
   from tags formatted "tag__<type>_<Label>"): Budget / Mid-Range / Premium / Luxury. */
.m-product-tag--budget { background-color: #4C8C4A; }
.m-product-tag--midrange { background-color: #2F80C4; }
.m-product-tag--premium { background-color: #B8860B; }
.m-product-tag--luxury { background-color: #111111; color: #E8C468; }
.m-product-tag--samedaydelivery { background-color: #D71920; }

/* Custom gpl-* landing pages that close on a full-bleed dark CTA/trust section
   (About, Graphic Design, Branding, Manufacturing, Website Development, Print
   On Demand, Fast Track Headwear): the theme's global #MainContent bottom
   padding otherwise leaves a band of white page background between that dark
   section and the dark footer. */
#MainContent:has(> .shopify-section:last-child.gpl-section-gd-cta),
#MainContent:has(> .shopify-section:last-child.gpl-section-pod-cta),
#MainContent:has(> .shopify-section:last-child.gpl-section-ft-tf) {
  padding-bottom: 0;
}
</style>
