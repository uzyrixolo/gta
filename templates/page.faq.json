    "faq": {
      "type": "gpl-faq",
      "blocks": {
        "cat_getting_started": {
          "type": "category",
          "settings": {
            "title": "Getting Started",
            "icon": "rocket",
            "question_1": "How do I place an order with GTA Print Lab?",
            "answer_1": "<p>You can order through our online shopping experience for eligible products, customize products through our Design Studio, or request a quote for larger, more complex, or specialized projects.</p>",
            "question_2": "How do I get started?",
            "answer_2": "<p>Upload your design, choose your product, sizes and quantities, and pick a printing technique — our online customizer walks you through it in a couple of minutes. Prefer to talk it through first? <a href=\"/pages/contact\" title=\"Contact\">Reach out</a> and our team will help you get a quote.</p>"
          }
        },
        "cat_ordering": {
          "type": "category",
          "settings": {
            "title": "Ordering & Minimums",
            "icon": "cart",
            "question_1": "Is there a minimum order quantity?",
            "answer_1": "<p>No minimums, ever. Order a single custom hoodie or a run of 10,000 team jerseys — you'll get the same quality and pricing structure either way, with volume discounts kicking in as your order grows.</p>"
          }
        },
        "cat_pricing": {
          "type": "category",
          "settings": {
            "title": "Pricing & Quotes",
            "icon": "tag",
            "question_1": "Do you offer bulk or volume discounts?",
            "answer_1": "<p>Yes — the more you order, the more you save. Discounts scale automatically as your quantity goes up, whether you're ordering for a team, event, fundraiser or business.</p>"
          }
        },
        "cat_artwork": {
          "type": "category",
          "settings": {
            "title": "Artwork & Design",
            "icon": "image",
            "question_1": "What file types do you accept for artwork?",
            "answer_1": "<p>We accept PNG, JPG, SVG, PDF, HEIC and TIFF files. For the sharpest print quality, high-resolution PNG or vector (SVG/PDF) files work best. If your file isn't print-ready, our team will reach out to help clean it up.</p>",
            "question_2": "Can I see a mockup before you print?",
            "answer_2": "<p>Yes. Every order includes a digital mockup for your approval before production starts — usually within an hour of your upload. Nothing goes to print until you say go.</p>"
          }
        },
        "cat_printing": {
          "type": "category",
          "settings": {
            "title": "Printing Methods",
            "icon": "tshirt",
            "question_1": "What printing methods do you offer?",
            "answer_1": "<p>We print using DTG (Direct-to-Garment) for vibrant full-colour designs, DTF (Direct-to-Film) for durability across almost any fabric, and embroidery for a premium stitched finish on hats, polos and jackets. Not sure which is right for your project? We'll recommend the best option when you upload your artwork.</p>"
          }
        },
        "cat_turnaround": {
          "type": "category",
          "settings": {
            "title": "Turnaround Time",
            "icon": "clock",
            "question_1": "How fast can you turn around my order?",
            "answer_1": "<p>Most orders ship same-day or next-day, depending on order size and printing method. Larger bulk orders typically take 3–5 business days. Need it faster? Ask about our Rush Order Service to jump the queue.</p>"
          }
        },
        "cat_delivery": {
          "type": "category",
          "settings": {
            "title": "Delivery & Shipping",
            "icon": "truck",
            "question_1": "What areas do you deliver to?",
            "answer_1": "<p>We offer fast local delivery across Toronto, North York, Scarborough, Etobicoke, Mississauga, Brampton, Vaughan, Markham, Pickering, Ajax, Whitby and the rest of the GTA — plus reliable shipping across Canada.</p>",
            "question_2": "Can I pick up my order in person?",
            "answer_2": "<p>Yes — in-store pickup is available in addition to local delivery and Canada-wide shipping.</p>"
          }
        },
        "cat_quality": {
          "type": "category",
          "settings": {
            "title": "Quality & Production",
            "icon": "badge",
            "question_1": "What if something's wrong with my order?",
            "answer_1": "<p>Every order is inspected for quality before it leaves our facility. If something isn't right, <a href=\"/pages/contact\" title=\"Contact\">contact us</a> and we'll make it right — that's our guarantee.</p>"
          }
        }
      },
